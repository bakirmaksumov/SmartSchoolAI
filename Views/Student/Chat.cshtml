@using SmartSchoolAI.Models.Dtos
@model SmartSchoolAI.Models.ChatSession
@{
    ViewData["Title"] = "AI Tutor";
    var result   = ViewBag.Result as SmartSchoolAI.Models.StudentResult;
    var mode     = ViewBag.Mode as string ?? "hint";
    var messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageDto>>(Model.Messages)
                   ?? new List<ChatMessageDto>();
    var modeLabel = mode == "hint" ? "Hints" : mode == "explain" ? "Explanation" : "Re-attempt Help";
    var modeIcon  = mode == "hint" ? "bx-bulb" : mode == "explain" ? "bx-book-reader" : "bx-refresh";
}

<!-- WIUT AI Tutor Header Banner -->
<div class="wiut-hero-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h3 class="fw-bold text-white mb-1"><i class="bx @modeIcon me-2"></i>AI Academic Assistant — @modeLabel</h3>
      <p class="text-white-50 mb-0">@result?.Assignment.Title</p>
    </div>
    <div>
      <a asp-action="AssignmentResult"
         asp-route-assignmentId="@result?.AssignmentId"
         asp-route-resultId="@result?.Id"
         class="btn btn-outline-light btn-sm">
        <i class="bx bx-arrow-back me-1"></i> Back to Result
      </a>
    </div>
  </div>
</div>

<!-- Chat window -->
<div class="card card-hover mb-3">
  <div class="card-body p-3" id="chatBox"
       style="min-height: 350px; max-height: 500px; overflow-y: auto;">
    @if (!messages.Any())
    {
      <div class="text-center py-5">
        <div class="avatar avatar-xl bg-label-primary mx-auto mb-3 p-3 rounded-circle">
          <i class="bx bx-bot text-primary" style="font-size:2.5rem;"></i>
        </div>
        <h5 class="fw-bold text-primary mb-1">Hello! I am your AI Academic Tutor</h5>
        <p class="text-muted">Ask me anything about step-by-step solutions or concepts for this assignment.</p>
      </div>
    }
    @foreach (var msg in messages)
    {
      @if (msg.Role == "user")
      {
        <div class="d-flex justify-content-end mb-3">
          <div class="bg-primary text-white rounded-3 p-3 math-render shadow-sm" style="max-width:75%; border-bottom-right-radius: 4px !important;">
            @msg.Content
          </div>
        </div>
      }
      else
      {
        <div class="d-flex justify-content-start mb-3 gap-2">
          <div class="avatar avatar-sm flex-shrink-0">
            <span class="avatar-initial rounded-circle bg-label-danger" style="border: 1.5px solid var(--wiut-crimson);">
              <i class="bx bx-bot text-danger"></i>
            </span>
          </div>
          <div class="bg-lighter rounded-3 p-3 math-render shadow-sm border" style="max-width:75%; border-bottom-left-radius: 4px !important;">
            @msg.Content
          </div>
        </div>
      }
    }
  </div>
</div>

<!-- Quick Suggestion Chips -->
<div class="mb-3 d-flex flex-wrap gap-2">
  <span class="chat-prompt-chip" onclick="fillPrompt('Can you explain step 1 in more detail?')">💡 Explain step 1</span>
  <span class="chat-prompt-chip" onclick="fillPrompt('Show me a similar example question')">📚 Show similar example</span>
  <span class="chat-prompt-chip" onclick="fillPrompt('What key formula should I use here?')">📐 Key formula</span>
</div>

<!-- Input area -->
<form method="post" asp-action="SendChatMessage">
  @Html.AntiForgeryToken()
  <input type="hidden" name="sessionId" value="@Model.Id" />
  <div class="input-group input-group-merge shadow-sm">
    <input type="text" id="userMessageInput" name="userMessage" class="form-control form-control-lg"
           placeholder="Ask the AI tutor a question..." required autofocus />
    <button type="submit" class="btn btn-primary px-4">
      <i class="bx bx-send me-1"></i> Send
    </button>
  </div>
</form>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
<script>
  function fillPrompt(txt) {
    var input = document.getElementById('userMessageInput');
    if (input) {
      input.value = txt;
      input.focus();
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Auto-scroll chat to bottom on load
    var box = document.getElementById('chatBox');
    if (box) box.scrollTop = box.scrollHeight;

    // Render the tutor's LaTeX ($...$) instead of showing raw source text.
    if (typeof renderMathInElement !== 'function') return;
    document.querySelectorAll('.math-render').forEach(function (el) {
      renderMathInElement(el, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false },
          { left: '\\(', right: '\\)', display: false },
          { left: '\\[', right: '\\]', display: true }
        ],
        throwOnError: false
      });
    });
  });
</script>
}
