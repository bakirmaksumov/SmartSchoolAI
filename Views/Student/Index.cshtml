@model SmartSchoolAI.ViewModels.MyWorkViewModel
@using SmartSchoolAI.Services
@{
    ViewData["Title"] = "My work";
    var next = Model.Next;
    var sections = new[] { ("todo", "To do"), ("submitted", "Submitted"), ("feedback", "Feedback") };
    var classFilterName = Model.Classes.FirstOrDefault(c => c.Id == Model.ClassId)?.Name;
}

<div class="my-work" id="myWork" data-query="@Context.Request.QueryString">

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <h4 class="fw-bold mb-0 me-auto">My work</h4>
  <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#joinClassModal">
    <i class="bx bx-plus me-1" aria-hidden="true"></i>Join a class
  </button>
</div>

@if (!Model.Classes.Any())
{
  <div class="card" id="noClasses">
    <div class="card-body text-center py-5">
      <i class="bx bx-book-open text-primary" style="font-size:3rem;" aria-hidden="true"></i>
      <h5 class="mt-3 fw-bold">Join a class to get started</h5>
      <p class="text-muted">Ask your teacher for the 6-character invite code.</p>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#joinClassModal">
        <i class="bx bx-log-in me-1" aria-hidden="true"></i>Join a class
      </button>
    </div>
  </div>
}
else
{
  <div class="row g-3">
    <div class="col-lg-8">
      <!-- Next up: the one thing to do now -->
      <section class="card next-up mb-3" id="nextUp" aria-labelledby="nextUpTitle">
        <div class="card-body">
          <h2 class="next-up-label" id="nextUpTitle">Next up</h2>
          @if (next is not null)
          {
            <div class="next-up-title">@next.Assignment.Title</div>
            <div class="text-muted mb-2">@next.ClassName</div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
              <span class="badge bg-label-@(next.State == StudentWorkState.InProgress ? "primary" : next.Overdue ? "danger" : "secondary")" data-status>
                <i class="bx @(next.State == StudentWorkState.InProgress ? "bx-edit" : "bx-circle") me-1" aria-hidden="true"></i>@next.StatusText
              </span>
              <span class="@(next.Overdue ? "text-danger fw-semibold" : "")" data-due title="@SchoolTime.Label">
                <i class="bx bx-calendar me-1" aria-hidden="true"></i>@(next.PersonalDue ? "Your deadline: " : "")@StudentWork.DueText(next.Due, Model.Now)@(next.Due.HasValue ? $" ({SchoolTime.Label})" : "")
              </span>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-primary next-up-action" href="@next.Primary!.Url" id="nextUpAction">
                <i class="bx @next.Primary.Icon me-1" aria-hidden="true"></i>@next.Primary.Label
              </a>
              @if (next.Secondary is { } s2)
              {
                <a class="btn btn-outline-secondary" href="@s2.Url"><i class="bx @s2.Icon me-1" aria-hidden="true"></i>@s2.Label</a>
              }
            </div>
          }
          else if (!Model.Work.Any())
          {
            <div class="next-up-title">No assignments for you yet</div>
            <p class="text-muted mb-0" id="noWorkYet">
              You are in @string.Join(", ", Model.Classes.Select(c => c.Name)). Work your teacher gives you will appear here.
            </p>
          }
          else
          {
            <div class="next-up-title">You're all caught up</div>
            <p class="text-muted mb-0">Nothing to start or continue right now@(classFilterName is null ? "" : $" in {classFilterName}").</p>
          }
        </div>
      </section>

      <!-- To do / Submitted / Feedback, for all classes or one -->
      <section class="card" aria-label="My work list">
        <div class="card-header d-flex flex-wrap align-items-center gap-2 pb-0">
          <ul class="nav nav-tabs work-tabs me-auto" role="tablist" id="workTabs">
            @foreach (var (key, label) in sections)
            {
              var on = Model.Section == key;
              <li class="nav-item" role="presentation">
                <a class="nav-link @(on ? "active" : "")" href="@Model.Link(key)" data-section="@key" role="tab"
                   aria-selected="@(on ? "true" : "false")" aria-current="@(on ? "page" : null)">
                  @label <span class="badge rounded-pill bg-label-secondary ms-1">@Model.Count(key)</span>
                </a>
              </li>
            }
          </ul>
          <form method="get" action="/Student" class="mb-2">
            <input type="hidden" name="section" value="@Model.Section" />
            <label class="visually-hidden" for="classFilter">Class</label>
            <select class="form-select form-select-sm" id="classFilter" name="classId" onchange="this.form.submit()">
              <option value="">All classes</option>
              @foreach (var c in Model.Classes)
              {
                <option value="@c.Id" selected="@(c.Id == Model.ClassId)">@c.Name</option>
              }
            </select>
            <noscript><button class="btn btn-sm btn-outline-primary mt-1">Show</button></noscript>
          </form>
        </div>
        <div class="card-body pt-2" id="workList" data-section="@Model.Section">
          @if (!Model.InSection.Any())
          {
            <p class="text-muted my-4 text-center" id="sectionEmpty">
              @(Model.Section switch
              {
                  "submitted" => "Nothing is waiting for a mark.",
                  "feedback"  => "No feedback yet.",
                  _           => Model.Work.Any() ? "Nothing to do here — well done." : "No assignments for you yet."
              })
            </p>
          }
          else
          {
            @foreach (var item in Model.Shown)
            {
              <partial name="_WorkItem" model="item" />
            }
            @if (!Model.ShowAll && Model.InSection.Count > MyWorkViewModel.ShortList)
            {
              <a class="btn btn-link px-0 mt-2" id="viewAllWork" href="@Model.Link(all: true)">View all work (@Model.InSection.Count)</a>
            }
          }
        </div>
      </section>
    </div>

    <div class="col-lg-4">
      <!-- Results the student may see -->
      <section class="card mb-3" id="recentFeedback" aria-labelledby="recentFeedbackTitle">
        <div class="card-body">
          <h2 class="h6 fw-bold mb-3" id="recentFeedbackTitle">Recent feedback</h2>
          @if (!Model.RecentFeedback.Any())
          {
            <p class="text-muted mb-0" id="noGrades">No grades yet</p>
          }
          else
          {
            <ul class="list-unstyled mb-3">
              @foreach (var f in Model.RecentFeedback)
              {
                var r = f.LatestFeedback!;
                <li class="d-flex align-items-center justify-content-between gap-2 py-2 border-bottom">
                  <a class="min-w-0 text-truncate" href="/Student/AssignmentResult?assignmentId=@f.Assignment.Id&resultId=@r.Id">@f.Assignment.Title</a>
                  <span class="badge bg-label-success flex-shrink-0" data-score>@f.Assignment.FormatGrade(r.Score)</span>
                </li>
              }
            </ul>
            <div class="small text-muted" id="averageScore" title="Average of the results you can see (newest attempt of each assignment).">
              Average: <strong class="text-body">@Model.Average%</strong> · @AnalyticsService.Plural(Model.GradedCount, "graded assignment")
            </div>
          }
        </div>
      </section>

      <!-- Classes -->
      <section class="card" aria-labelledby="myClassesTitle">
        <div class="card-body">
          <h2 class="h6 fw-bold mb-3" id="myClassesTitle">My classes</h2>
          <ul class="list-unstyled mb-0">
            @foreach (var c in Model.Classes)
            {
              <li class="py-1"><a href="/Student/Assignments?classId=@c.Id"><i class="bx bx-book me-1" aria-hidden="true"></i>@c.Name</a>
                <span class="small text-muted">· @c.Teacher.FullName</span></li>
            }
          </ul>
        </div>
      </section>
    </div>
  </div>
}
</div>

<!-- Join Class Modal -->
<div class="modal fade" id="joinClassModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="post" asp-action="JoinClass">
        @Html.AntiForgeryToken()
        <div class="modal-header">
          <h5 class="modal-title">Join a Class</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label class="form-label" for="inviteCode">Invite Code</label>
          <input type="text" id="inviteCode" name="inviteCode" class="form-control text-uppercase"
                 placeholder="e.g. AB3XY7" maxlength="6" required />
          <div class="form-text">Enter the 6-character code from your teacher</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="bx bx-log-in me-1"></i> Join Class
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <link rel="stylesheet" href="~/css/my-work.css" asp-append-version="true" />
  <script>
    // Coming back to "My work" (from an assignment, a result, the menu) restores the class and section last chosen.
    (function () {
      var key = 'myWork:query', page = document.getElementById('myWork');
      if (!page) return;
      var q = page.dataset.query || '';
      try {
        if (q) sessionStorage.setItem(key, q);
        else if (sessionStorage.getItem(key) && document.referrer.indexOf(location.origin) === 0 && !/[?&]reset=1/.test(location.search))
          location.replace('/Student' + sessionStorage.getItem(key));
      } catch (e) { /* storage unavailable: start from the default view */ }
    })();
  </script>
}
