@model List<SmartSchoolAI.Models.Class>
@{
    ViewData["Title"] = "My Classes";
    var submittedResults = ViewBag.SubmittedResults as Dictionary<System.Guid, SmartSchoolAI.Models.StudentResult> ?? new();
}

<!-- Hero Banner for My Classes -->
<div class="wiut-hero-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h3 class="fw-bold text-white mb-1"><i class="bx bx-book-open me-2"></i>My Enrolled Classes</h3>
      <p class="text-white-50 mb-0">Select a course to view all its assignments and learning modules</p>
    </div>
    <div>
      <button class="btn btn-danger shadow-sm" data-bs-toggle="modal" data-bs-target="#joinClassModal">
        <i class="bx bx-plus me-1"></i> Join a Class
      </button>
    </div>
  </div>
</div>

@if (!Model.Any())
{
  <div class="card card-hover">
    <div class="card-body text-center py-5">
      <i class="bx bx-book-open text-primary" style="font-size:3.5rem;"></i>
      <h5 class="mt-3 text-primary fw-bold">No classes enrolled yet</h5>
      <p class="text-muted">Ask your instructor for an invite code to join your first class.</p>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#joinClassModal">
        <i class="bx bx-plus me-1"></i> Join a Class
      </button>
    </div>
  </div>
}
else
{
  <div class="row">
    @foreach (var cls in Model)
    {
      var totalAssigned = cls.Assignments.Count;
      var completedInClass = cls.Assignments.Count(a => submittedResults.ContainsKey(a.Id));
      var progressPercent = totalAssigned > 0 ? (completedInClass * 100 / totalAssigned) : 0;

      <div class="col-md-6 col-xl-4 mb-4">
        <div class="card card-hover h-100">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-label-primary">Grade @cls.GradeLevel</span>
                <span class="badge bg-label-info">@cls.Subject</span>
              </div>
              <h4 class="card-title fw-bold text-primary mb-1">@cls.Name</h4>
              <p class="text-muted small mb-3">
                <i class="bx bx-user me-1"></i>Instructor: @cls.Teacher.FullName
              </p>
            </div>

            <div>
              <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span>Course Completion</span>
                <span class="text-primary">@completedInClass / @totalAssigned Tasks (@progressPercent%)</span>
              </div>
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
              </div>

              <a asp-action="Assignments" asp-route-classId="@cls.Id" class="btn btn-primary btn-sm w-100">
                <i class="bx bx-folder-open me-1"></i> Open Course Assignments
              </a>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
}

<!-- Join Class Modal -->
<div class="modal fade" id="joinClassModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="post" asp-action="JoinClass">
        @Html.AntiForgeryToken()
        <div class="modal-header">
          <h5 class="modal-title">Join a Class</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Invite Code</label>
          <input type="text" name="inviteCode" class="form-control text-uppercase"
                 placeholder="e.g. AB3XY7" maxlength="6" required />
          <div class="form-text">Enter the 6-character code from your teacher</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="bx bx-log-in me-1"></i> Join Class
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
