@model List<SmartSchoolAI.Services.StudentWorkItem>
@{
    ViewData["Title"] = "Assignments";
    var cls = ViewBag.Class as SmartSchoolAI.Models.Class;
}

<div class="my-work">
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="me-auto">
    <h4 class="fw-bold mb-0">@cls?.Name</h4>
    <div class="text-muted small">@cls?.Subject · Grade @cls?.GradeLevel · Instructor: @cls?.Teacher.FullName</div>
  </div>
  <a href="/Student?section=todo&classId=@cls?.Id" class="btn btn-outline-secondary btn-sm">
    <i class="bx bx-arrow-back me-1" aria-hidden="true"></i>My work in this class
  </a>
</div>

<div class="card">
  <div class="card-body" id="classWork">
    @if (!Model.Any())
    {
      <p class="text-muted text-center my-4" id="classNoWork">No assignments for you yet in @cls?.Name.</p>
    }
    else
    {
      @foreach (var item in Model)
      {
        <partial name="_WorkItem" model="item" />
      }
    }
  </div>
</div>
</div>

@section Scripts {
  <link rel="stylesheet" href="~/css/my-work.css" asp-append-version="true" />
}
