@model List<SmartSchoolAI.Models.Assignment>
@{
    ViewData["Title"] = "Assignments";
    var cls     = ViewBag.Class as SmartSchoolAI.Models.Class;
    var results = ViewBag.Results as Dictionary<Guid, SmartSchoolAI.Models.StudentResult>
                  ?? new Dictionary<Guid, SmartSchoolAI.Models.StudentResult>();
}

<!-- Page header & WIUT Hero Banner -->
<div class="wiut-hero-card mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h3 class="fw-bold text-white mb-1"><i class="bx bx-book-open me-2"></i>@cls?.Name</h3>
      <p class="text-white-50 mb-0">@cls?.Subject · Grade @cls?.GradeLevel · Instructor: @cls?.Teacher.FullName</p>
    </div>
    <div>
      <a asp-action="Index" asp-controller="Student" class="btn btn-outline-light btn-sm">
        <i class="bx bx-arrow-back me-1"></i> Back to Dashboard
      </a>
    </div>
  </div>
</div>

@if (!Model.Any())
{
  <div class="card card-hover">
    <div class="card-body text-center py-5">
      <i class="bx bx-task text-primary" style="font-size:3.5rem;"></i>
      <h5 class="mt-3 text-primary fw-bold">No active assignments</h5>
      <p class="text-muted">Your instructor hasn't published any assignments yet.</p>
    </div>
  </div>
}
else
{
  <div class="row">
    @foreach (var a in Model)
    {
      var submitted = results.ContainsKey(a.Id);
      var result    = submitted ? results[a.Id] : null;
      <div class="col-md-6 col-xl-4 mb-4">
        <div class="card card-hover h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-start justify-content-between mb-2">
              <div class="avatar">
                <span class="avatar-initial rounded bg-label-primary">
                  <i class="bx bx-@(a.Type == SmartSchoolAI.Models.AssignmentType.Homework ? "home" : "chalkboard")"></i>
                </span>
              </div>
              @if (submitted)
              {
                <span class="badge bg-success"><i class="bx bx-check me-1"></i>@result!.Score%</span>
              }
              else
              {
                <span class="badge bg-label-warning">Pending</span>
              }
            </div>
            <h5 class="card-title mt-2 mb-1">@a.Title</h5>
            <p class="text-muted small mb-2 flex-grow-1">@a.Description</p>
            <div class="mb-3">
              <span class="badge bg-label-@(a.Type == SmartSchoolAI.Models.AssignmentType.Homework ? "primary" : "info") me-1">
                @a.Type
              </span>
              @if (a.Deadline.HasValue)
              {
                <span class="badge bg-label-@(a.Deadline.Value < DateTime.UtcNow ? "danger" : "secondary")">
                  <i class="bx bx-time me-1"></i>@a.Deadline.Value.ToString("dd MMM yyyy")
                </span>
              }
            </div>
            @if (!submitted)
            {
              <a asp-action="TakeAssignment" asp-route-assignmentId="@a.Id"
                 class="btn btn-primary btn-sm">
                <i class="bx bx-play me-1"></i> Start Assignment
              </a>
            }
            else
            {
              <a asp-action="AssignmentResult"
                 asp-route-assignmentId="@a.Id"
                 asp-route-resultId="@result!.Id"
                 class="btn btn-outline-success btn-sm">
                <i class="bx bx-bar-chart-alt-2 me-1"></i> View My Result
              </a>
            }
          </div>
        </div>
      </div>
    }
  </div>
}
