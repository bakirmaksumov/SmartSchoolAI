@{
    ViewData["Title"] = "Set a New Password";
    Layout = "_AuthLayout";
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card">
        <div class="card-body">

          <!-- Logo -->
          <div class="app-brand justify-content-center mb-4">
            <a href="/" class="app-brand-link gap-2">
              <i class="bx bx-brain" style="font-size:32px; color:#696cff;"></i>
              <span class="app-brand-text demo text-body fw-bolder">SmartSchool AI</span>
            </a>
          </div>

          <h4 class="mb-2">Set a new password 🔐</h4>
          <p class="mb-4 text-muted">
            Your teacher gave you a temporary password. Choose your own to continue.
          </p>

          @if (!string.IsNullOrEmpty(ViewBag.Error))
          {
            <div class="alert alert-danger">
              <i class="bx bx-error-circle me-1"></i> @ViewBag.Error
            </div>
          }

          <form method="post" asp-action="ChangePassword" asp-controller="Auth">
            @Html.AntiForgeryToken()

            <div class="mb-3 form-password-toggle">
              <label class="form-label" for="newPassword">New password</label>
              <div class="input-group input-group-merge">
                <input type="password" class="form-control" id="newPassword" name="newPassword"
                       placeholder="At least 8 characters" autofocus required />
                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
              </div>
            </div>

            <div class="mb-3 form-password-toggle">
              <label class="form-label" for="confirmPassword">Confirm new password</label>
              <div class="input-group input-group-merge">
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                       placeholder="Re-enter your new password" required />
                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
              </div>
            </div>

            <button class="btn btn-primary d-grid w-100" type="submit">Save and continue</button>
          </form>

          <p class="text-center mt-3">
            <a asp-action="Logout" asp-controller="Auth"><i class="bx bx-log-out me-1"></i>Sign out</a>
          </p>

        </div>
      </div>
    </div>
  </div>
</div>
