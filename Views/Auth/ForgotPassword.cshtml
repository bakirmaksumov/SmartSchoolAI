@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card card-hover shadow-lg" style="border-radius: 1rem; border: 1px solid rgba(0, 43, 73, 0.1);">
        <div class="card-body p-4 p-sm-5">

          <div class="app-brand justify-content-center mb-4">
            <a href="/" class="app-brand-link gap-2 align-items-center">
              <span class="eduai-logo-badge" style="width: 44px; height: 44px;">
                <i class="bx bx-graduation" style="font-size: 24px;"></i>
              </span>
            </a>
          </div>

          <h4 class="mb-2 text-center">Forgot your password?</h4>
          <p class="mb-4 text-center text-muted">
            There's no automatic email reset yet — ask whoever manages your account directly.
          </p>

          <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bx bx-user-voice fs-4"></i>
            <div>
              <strong>Students</strong> — ask your teacher. They can reset it for you from their class's student list.
            </div>
          </div>

          <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bx bx-shield-quarter fs-4"></i>
            <div>
              <strong>Teachers</strong> — ask your school administrator. They can reset it for you from the Admin Panel.
            </div>
          </div>

          <div class="text-center mt-4">
            <a href="/Auth/Login"><i class="bx bx-chevron-left"></i> Back to login</a>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
