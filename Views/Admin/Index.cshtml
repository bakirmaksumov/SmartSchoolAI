@model List<SmartSchoolAI.Models.User>
@{
    ViewData["Title"] = "Admin Panel";
    var search = ViewBag.Search as string;
}

<div class="row mb-4">
  <div class="col">
    <h4 class="fw-bold py-3 mb-0">
      <span class="text-muted fw-light">SmartSchool AI /</span> Admin Panel
    </h4>
    <p class="text-muted mb-0">Reset a teacher's password when they're locked out and have no self-service recovery.</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="form-label small text-muted mb-1">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bx bx-search"></i></span>
          <input type="text" class="form-control" name="search" value="@search"
                 placeholder="Name or email…" />
        </div>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h5 class="mb-0"><i class="bx bx-chalkboard me-2"></i>Teachers (@Model.Count)</h5>
  </div>
  <div class="card-body p-0">
    @if (!Model.Any())
    {
      <p class="text-muted text-center py-4 mb-0">No teachers found.</p>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Teacher</th>
              <th>Email</th>
              <th>School</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var t in Model)
            {
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="avatar avatar-sm me-2">
                      <span class="avatar-initial rounded-circle bg-label-primary">@t.FullName.Substring(0, 1)</span>
                    </div>
                    <strong>@t.FullName</strong>
                  </div>
                </td>
                <td class="text-muted small">@t.Email</td>
                <td class="text-muted small">@(t.School ?? "—")</td>
                <td>
                  <button type="button" class="btn btn-sm btn-outline-warning"
                          onclick="openResetPassword('@t.Id', '@t.FullName')">
                    <i class="bx bx-lock-open-alt me-1"></i>Reset password
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<!-- ══ RESET PASSWORD MODAL ═══════════════════════════════════════════ -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form method="post" asp-controller="Admin" asp-action="ResetTeacherPassword" class="modal-content">
      @Html.AntiForgeryToken()
      <input type="hidden" name="teacherId" id="resetTeacherId" />

      <div class="modal-header">
        <h5 class="modal-title mb-0"><i class="bx bx-lock-open-alt me-2"></i>Reset password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">
          Set a new password for <strong id="resetTeacherName"></strong>.
          Their old password stops working straight away, so pass them the new one.
        </p>
        <label class="form-label">New password <span class="text-danger">*</span></label>
        <input type="text" class="form-control" name="newPassword" id="resetPasswordInput"
               minlength="8" required />
        <div class="form-text">At least 8 characters. Shown as plain text so you can pass it on.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning"><i class="bx bx-reset me-1"></i>Reset password</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openResetPassword(teacherId, name) {
    document.getElementById('resetTeacherId').value   = teacherId;
    document.getElementById('resetTeacherName').textContent = name;
    document.getElementById('resetPasswordInput').value = '';
    new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
  }
</script>
