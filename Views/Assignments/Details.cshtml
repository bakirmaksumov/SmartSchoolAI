@model SmartSchoolAI.ViewModels.AssignmentDetailsViewModel
@using SmartSchoolAI.Models
@using SmartSchoolAI.Services
@{
    var a = Model.Assignment;
    var p = Model.Progress;
    ViewData["Title"] = a.Title;
    var statusTone = a.Status switch
    {
        AssignmentStatus.Active   => "success",
        AssignmentStatus.Draft    => "secondary",
        AssignmentStatus.Closed   => "warning",
        _                         => "dark"
    };
    var hasSubmissions = a.StudentResults.Any(r => r.IsSubmitted);
    string Tab(string t) => Model.Tab == t ? "active" : "";
    string Pane(string t) => Model.Tab == t ? "" : "d-none";
}

<div class="assignment-page" id="assignmentPage" data-assignment="@a.Id" data-signature="@p.Signature"
     data-live="@(a.Status == AssignmentStatus.Active ? "true" : "false")">

  <!-- ── Header ─────────────────────────────────────────────────────────── -->
  <a href="/Assignments" class="small text-muted d-inline-flex align-items-center gap-1 mt-2"><i class="bx bx-arrow-back"></i> Assignments</a>
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mt-2 mb-4">
    <div class="min-w-0">
      <h3 class="fw-bold mb-1 d-flex flex-wrap align-items-center gap-2">
        <span class="text-break">@a.Title</span>
        <span class="badge rounded-pill bg-label-@statusTone fs-6" id="assignmentStatus"><span class="status-dot bg-@statusTone"></span>@a.Status</span>
      </h3>
      <div class="text-muted">
        <a href="/Classes/Details/@a.ClassId" class="text-muted">@a.Class.Name</a>
        · @(a.Type == AssignmentType.Homework ? "Homework" : "Classroom practice")
        · @(a.Deadline.HasValue ? $"Due {SchoolTime.Show(a.Deadline, "dd MMM, HH:mm")}" : "No due date")
        @if (a.Deadline.HasValue)
        {
          <span class="small">(@SchoolTime.Label)</span>
        }
      </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      @if (a.Status == AssignmentStatus.Active)
      {
        <span class="badge bg-label-danger d-inline-flex align-items-center gap-1" id="liveBadge" title="Updates by itself as students hand in work">
          <span class="spinner-grow spinner-grow-sm" style="width:.5rem;height:.5rem;"></span>Live
        </span>
      }
      @if (a.Status == AssignmentStatus.Draft && Model.AssignPanel is not null)
      {
        <button type="button" class="btn btn-primary" id="openAssignBtn" data-bs-toggle="modal" data-bs-target="#assignModal">
          <i class="bx bx-send me-1"></i> Assign
        </button>
      }
      @if (a.Status != AssignmentStatus.Archived)
      {
        <a href="/Assignments/Edit/@a.Id?tab=settings" class="btn btn-outline-secondary"><i class="bx bx-cog me-1"></i> Settings</a>
      }
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="moreMenu">More</button>
        <ul class="dropdown-menu dropdown-menu-end">
          @if (Model.CanEditQuestions)
          {
            <li><a class="dropdown-item" href="/Assignments/Edit/@a.Id"><i class="bx bx-pencil me-2"></i>Edit questions</a></li>
          }
          else if (hasSubmissions && a.Status != AssignmentStatus.Archived)
          {
            <li><span class="dropdown-item disabled" title="Students have answered — changing questions would mis-align their marks"><i class="bx bx-lock-alt me-2"></i>Questions locked</span></li>
          }
          <li><a class="dropdown-item" href="/Assignments/Preview/@a.Id" target="_blank" rel="noopener"><i class="bx bx-show me-2"></i>Preview as student</a></li>
          @if (a.Status == AssignmentStatus.Active && Model.AssignPanel is not null)
          {
            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#assignModal" id="menuAssignMore"><i class="bx bx-user-plus me-2"></i>Assign more students</button></li>
          }
          <li><a class="dropdown-item" href="/Assignments/ExportGrades/@a.Id"><i class="bx bx-download me-2"></i>Export CSV</a></li>
          <li><hr class="dropdown-divider" /></li>
          @if (a.Status == AssignmentStatus.Active)
          {
            <li>
              <form method="post" asp-action="Close" asp-route-id="@a.Id" onsubmit="return confirm('Close this assignment? Students can no longer submit. You can reopen it afterwards.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item text-warning"><i class="bx bx-lock me-2"></i>Close</button>
              </form>
            </li>
          }
          @if (a.Status == AssignmentStatus.Closed)
          {
            <li>
              <form method="post" asp-action="Reopen" asp-route-id="@a.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item"><i class="bx bx-lock-open me-2"></i>Reopen</button>
              </form>
            </li>
          }
          @if (a.Status != AssignmentStatus.Active)
          {
            <li>
              <form method="post" asp-action="Delete" asp-route-id="@a.Id" onsubmit="return confirm('Delete this assignment? This cannot be undone.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item text-danger"><i class="bx bx-trash me-2"></i>Delete</button>
              </form>
            </li>
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- ── Counters (click = filter the students) ─────────────────────────── -->
  <div class="row g-3 mb-4" id="liveCounters">@await Html.PartialAsync("_DetailsCounters", Model)</div>

  <!-- ── Tabs ───────────────────────────────────────────────────────────── -->
  <ul class="nav nav-tabs mb-3" id="detailTabs" role="tablist">
    <li class="nav-item"><a class="nav-link @Tab("students")" href="?tab=students" data-tab="students" role="tab">Students &amp; attempts</a></li>
    <li class="nav-item"><a class="nav-link @Tab("questions")" href="?tab=questions" data-tab="questions" role="tab">Question performance</a></li>
    <li class="nav-item"><a class="nav-link @Tab("details")" href="?tab=details" data-tab="details" role="tab">Assignment details</a></li>
  </ul>

  <!-- ══ STUDENTS & ATTEMPTS ══════════════════════════════════════════════ -->
  <section class="@Pane("students")" data-pane="students" id="paneStudents">
    <div class="card">
      <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <h5 class="mb-0 me-auto">Students &amp; attempts</h5>
        <div class="input-group input-group-sm student-search">
          <span class="input-group-text"><i class="bx bx-search"></i></span>
          <input type="search" class="form-control" id="studentSearch" placeholder="Search students" aria-label="Search students" autocomplete="off" />
        </div>
        <div class="form-check form-switch mb-0 mx-1">
          <input class="form-check-input" type="checkbox" id="anonToggle" />
          <label class="form-check-label small" for="anonToggle">Anonymous</label>
        </div>
        <a href="/Assignments/ExportGrades/@a.Id" class="btn btn-sm btn-primary" id="exportCsv"><i class="bx bx-download me-1"></i>Export CSV</a>
        @if (a.Status == AssignmentStatus.Active && Model.AssignPanel is not null)
        {
          <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignModal" id="openAssignBtn"><i class="bx bx-user-plus me-1"></i>Assign more</button>
        }
      </div>

      <div class="px-3 pt-2 small text-muted d-flex flex-wrap gap-2 align-items-center" id="filterInfo">
        <span id="filterLabel"></span>
        <button type="button" class="btn btn-link btn-sm p-0 d-none" id="clearFilter">Show all</button>
        @if (Model.PendingRequests > 0)
        {
          <span class="ms-auto">
            <a href="/Classes/Details/@a.ClassId?tab=students#pendingRequests" class="text-warning fw-semibold">@Model.PendingRequests waiting for your approval</a>
          </span>
        }
      </div>

      @if (p.Assigned == 0)
      {
        <div class="card-body text-center text-muted py-5" id="noRecipients">
          @if (!a.Class.ClassStudents.Any())
          {
            <p class="mb-2"><strong>@a.Class.Name</strong> has no students yet.</p>
            <a class="btn btn-sm btn-primary" href="/Classes/Details/@a.ClassId?tab=students&returnUrl=@Uri.EscapeDataString($"/Assignments/Details/{a.Id}")"><i class="bx bx-envelope me-1"></i>Invite students</a>
          }
          else
          {
            <p class="mb-2">Nobody has this assignment yet.</p>
            @if (Model.AssignPanel is not null)
            {
              <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#assignModal">Choose students</button>
            }
          }
        </div>
      }
      <div class="table-responsive-md @(p.Assigned == 0 ? "d-none" : "")">
        <table class="table mb-0 align-middle recipient-table" id="recipientTable">
          <thead class="table-light">
            <tr>
              <th class="toggle-cell"><span class="visually-hidden">Expand</span></th>
              <th>Student</th>
              <th>Submission</th>
              <th class="review-cell">Review</th>
              <th class="score-cell">Score</th>
              <th class="text-end action-cell">Action</th>
            </tr>
          </thead>
          @await Html.PartialAsync("_RecipientRows", Model)
        </table>
      </div>
      <div id="liveFormer">@await Html.PartialAsync("_FormerRows", Model)</div>
      <div class="card-footer small text-muted py-2" id="showingCount"></div>
    </div>
  </section>

  <!-- ══ QUESTION PERFORMANCE ═════════════════════════════════════════════ -->
  <section class="@Pane("questions")" data-pane="questions" id="paneQuestions">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-1">Question performance</h5>
        <div class="small text-muted" id="questionUnit">
          Counted in <strong>students</strong>: the newest submitted attempt of each of the @p.SubmittedStudents
          student@(p.SubmittedStudents == 1 ? "" : "s") who handed in. Earlier attempts and former recipients are not counted.
        </div>
      </div>
      <div class="card-body">
        @if (!Model.QuestionStats.Any())
        {
          <p class="text-muted mb-0">This assignment has no questions.</p>
        }
        <ol class="list-unstyled mb-0 question-stats">
          @foreach (var s in Model.QuestionStats)
          {
            if (s.IsStem)
            {
              <li class="qs-stem pt-2 pb-1">
                <span class="badge bg-label-primary me-2">@s.Label</span>
                <span class="math-render small text-muted">@s.Title</span>
              </li>
              continue;
            }
            var tone = s.SolveRate < 0 ? "secondary" : s.SolveRate < 50 ? "danger" : s.SolveRate < 80 ? "warning" : "success";
            <li class="qs-row @(s.IsPart ? "qs-part" : "")" data-question="@s.Index">
              <div class="qs-title">
                <span class="badge bg-label-secondary me-2">@s.Label</span>
                <span class="math-render">@s.Title</span>
              </div>
              <div class="qs-bar" role="img" aria-label="@(s.Answered == 0 ? "No answers" : $"{s.Correct} of {s.Answered} correct")">
                <div class="progress" style="height:8px;">
                  <div class="progress-bar bg-@tone" style="width:@(s.SolveRate < 0 ? 0 : s.SolveRate)%;"></div>
                </div>
              </div>
              <div class="qs-figure text-nowrap small">
                @if (s.Answered == 0)
                {
                  <span class="text-muted qs-none">No answers</span>
                }
                else
                {
                  <span class="fw-semibold text-@tone">@s.SolveRate%</span>
                  <span class="text-muted qs-fraction">@s.Correct of @s.Answered correct</span>
                  @if (s.NotMarked > 0)
                  {
                    <span class="text-muted d-block">@s.NotMarked not marked yet</span>
                  }
                }
              </div>
            </li>
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ══ ASSIGNMENT DETAILS ═══════════════════════════════════════════════ -->
  <section class="@Pane("details")" data-pane="details" id="paneDetails">
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0">Instructions</h5></div>
          <div class="card-body">
            @if (string.IsNullOrWhiteSpace(a.Description))
            {
              <p class="text-muted mb-0">No instructions were written for this assignment.</p>
            }
            else
            {
              <div class="math-render" style="white-space:pre-wrap;">@a.Description</div>
            }
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card">
          <div class="card-header"><h5 class="mb-0">Dates and rules</h5></div>
          <div class="card-body">
            <dl class="row mb-0 small settings-list">
              <dt class="col-6 text-muted fw-normal">Class</dt><dd class="col-6"><a href="/Classes/Details/@a.ClassId">@a.Class.Name</a></dd>
              <dt class="col-6 text-muted fw-normal">Type</dt><dd class="col-6">@(a.Type == AssignmentType.Homework ? "Homework" : "Classroom practice")</dd>
              <dt class="col-6 text-muted fw-normal">Status</dt><dd class="col-6">@a.Status</dd>
              <dt class="col-6 text-muted fw-normal">Opens</dt><dd class="col-6">@SchoolTime.Show(a.AvailableFrom, empty: "Straight away")</dd>
              <dt class="col-6 text-muted fw-normal">Due</dt><dd class="col-6">@SchoolTime.Show(a.Deadline, empty: "No due date")</dd>
              <dt class="col-6 text-muted fw-normal">Time zone</dt><dd class="col-6">@SchoolTime.Label</dd>
              <dt class="col-6 text-muted fw-normal">Personal dates</dt><dd class="col-6">@p.Rows.Count(r => r.Enrollment!.DueDateOverride.HasValue || r.Enrollment.StartDateOverride.HasValue) student(s)</dd>
              <dt class="col-6 text-muted fw-normal">Late submissions</dt><dd class="col-6">@(a.AllowLateSubmission ? "Allowed" : "Not allowed")</dd>
              <dt class="col-6 text-muted fw-normal">Attempts</dt><dd class="col-6">@(a.AllowsUnlimitedAttempts ? "Unlimited" : a.MaxAttempts.ToString())</dd>
              <dt class="col-6 text-muted fw-normal">Grading scale</dt><dd class="col-6">@a.GradingType</dd>
              <dt class="col-6 text-muted fw-normal">Pass mark</dt><dd class="col-6">@a.PassThreshold%</dd>
              <dt class="col-6 text-muted fw-normal">Questions</dt><dd class="col-6">@Model.QuestionCount · @Model.TotalMarks.ToString("0.##") marks</dd>
              <dt class="col-6 text-muted fw-normal">Instant feedback</dt><dd class="col-6">@(a.ShowsInstantFeedback ? "On" : "Off")</dd>
              <dt class="col-6 text-muted fw-normal">Tutor reveals solutions</dt><dd class="col-6">@(a.AllowSolutionReveal ? "Yes" : "No")</dd>
              <dt class="col-6 text-muted fw-normal">Pasting blocked</dt><dd class="col-6">@(a.AntiCopyPaste ? "Yes" : "No")</dd>
              <dt class="col-6 text-muted fw-normal">Created</dt><dd class="col-6">@SchoolTime.Show(a.CreatedAt, "dd MMM yyyy")</dd>
            </dl>
            @if (a.Status != AssignmentStatus.Archived)
            {
              <a href="/Assignments/Edit/@a.Id?tab=settings" class="btn btn-sm btn-outline-secondary mt-3"><i class="bx bx-cog me-1"></i>Change in Settings</a>
            }
          </div>
        </div>

        @if (a.Status is AssignmentStatus.Active or AssignmentStatus.Draft)
        {
          var follows = a.FollowsNewClassMembers;
          <div class="card mt-4" id="lateJoinCard">
            <div class="card-body">
              <h6 class="card-title mb-1"><i class="bx bx-user-plus me-1"></i>If a student joins the class later</h6>
              <p class="small text-muted mb-2">
                @if (!follows)
                {
                  <span id="lateJoinCurrent">They are <strong>not</strong> given this assignment — you add them by hand.</span>
                }
                else if (a.LateJoinPolicy == LateJoinPolicy.AutoAssign)
                {
                  <span id="lateJoinCurrent">They get it <strong>automatically</strong>.</span>
                }
                else
                {
                  <span id="lateJoinCurrent">They wait for <strong>your approval</strong> in the class's Students tab.</span>
                }
              </p>
              @if (a.Status == AssignmentStatus.Active)
              {
                <form method="post" asp-action="SetLateJoinPolicy" asp-route-id="@a.Id" class="d-flex gap-2 align-items-center" id="lateJoinForm">
                  @Html.AntiForgeryToken()
                  <select name="policy" class="form-select form-select-sm" aria-label="Rule for students who join later">
                    <option value="Manual" selected="@(!follows)">Don't assign (manual)</option>
                    <option value="AutoAssign" selected="@(follows && a.LateJoinPolicy == LateJoinPolicy.AutoAssign)">Assign automatically</option>
                    <option value="TeacherApproval" selected="@(follows && a.LateJoinPolicy == LateJoinPolicy.TeacherApproval)">With my approval</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                </form>
                <div class="form-text">Only affects students who join from now on. Nobody already in the class is added.</div>
              }
              else
              {
                <div class="form-text">You choose this when you assign the work.</div>
              }
            </div>
          </div>
        }
      </div>
    </div>
  </section>
</div>

@section Scripts {
  @if (Model.AssignPanel is not null)
  {
    <div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="assignModalTitle">
              @(a.Status == AssignmentStatus.Draft
                  ? (a.Type == AssignmentType.Homework ? "Assign homework" : "Assign practice")
                  : "Assign more students")
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            @await Html.PartialAsync("_AssignPanel", Model.AssignPanel)
          </div>
        </div>
      </div>
    </div>
  }

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
  <link rel="stylesheet" href="~/css/assignment-details.css" asp-append-version="true" />
  <script src="~/js/assignment-details.js" asp-append-version="true"></script>
}
