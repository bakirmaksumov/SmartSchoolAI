@using SmartSchoolAI.Models.Dtos
@model SmartSchoolAI.ViewModels.SubmissionDetailViewModel
@{
    var result    = Model.Result;
    var questions = Model.Questions;
    var layout    = SmartSchoolAI.Services.QuestionLayout.Compute(questions);   // "2a", "2b"; shared stems are context only
    ViewData["Title"] = $"Submission — {result.Student.FullName}";
    var scoreColor = result.Assignment.IsPass(result.Score) ? "success"
                 : result.Score >= result.Assignment.PassThreshold / 2 ? "warning" : "danger";
}

<div class="row mb-4">
  <div class="col">
    <h4 class="fw-bold py-3 mb-0">
      <span class="text-muted fw-light">
        SmartSchool AI /
        <a href="/Assignments" class="text-muted">Assignments</a> /
        <a href="/Assignments/Details/@result.AssignmentId" class="text-muted">@result.Assignment.Title</a> /
      </span> @result.Student.FullName
    </h4>
  </div>
  <div class="col-auto d-flex align-items-center">
    @{ var backUrl = ViewBag.ReturnUrl as string; }
    <a href="@(backUrl ?? $"/Assignments/Details/{result.AssignmentId}")" class="btn btn-outline-secondary btn-sm" id="submissionBack">
      <i class="bx bx-arrow-back me-1"></i> @(backUrl is null ? "Back to Assignment" : "Back")
    </a>
  </div>
</div>

<!-- Score summary row -->
<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card text-center h-100">
      <div class="card-body py-4">
        <div class="avatar avatar-xl mx-auto mb-3">
          @{ var unmarked = result.StudentAnswers.Count(SmartSchoolAI.Services.GradingService.IsUnfinished); }
          <span class="avatar-initial rounded-circle bg-label-@(unmarked > 0 ? "secondary" : scoreColor)" style="font-size:1.6rem;">
            @(unmarked > 0 ? "—" : result.Assignment.FormatGrade(result.Score))
          </span>
        </div>
        <h6 class="mb-1">Overall Score</h6>
        @if (unmarked > 0)
        {
          @* A technical failure is not a mark: the score waits until every answer is marked. *@
          <span class="badge bg-label-warning" data-score-pending>Not fully marked · @unmarked answer@(unmarked == 1 ? "" : "s") to mark</span>
        }
        else
        {
          <span class="badge bg-@scoreColor">@result.OverallStatus</span>
        }
        <div class="mt-2">
          @if (result.TeacherReviewedAt.HasValue)
          {
            <span class="badge bg-label-primary"><i class="bx bx-user-check me-1"></i>Teacher reviewed</span>
          }
          else
          {
            <span class="badge bg-label-secondary"><i class="bx bx-bot me-1"></i>AI graded</span>
          }
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card text-center h-100">
      <div class="card-body py-4">
        <i class="bx bx-user text-primary mb-2" style="font-size:2rem;"></i>
        <h6 class="mb-1">@result.Student.FullName</h6>
        <small class="text-muted">@result.Student.Email</small>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card text-center h-100">
      <div class="card-body py-4">
        <i class="bx bx-calendar text-info mb-2" style="font-size:2rem;"></i>
        <h6 class="mb-1">Submitted</h6>
        <small class="text-muted">@SmartSchoolAI.Services.SchoolTime.Show(result.SubmittedAt)</small>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card text-center h-100">
      <div class="card-body py-4">
        <i class="bx bx-revision text-warning mb-2" style="font-size:2rem;"></i>
        <h6 class="mb-1">Attempt</h6>
        <span class="text-muted">
          @if (result.Assignment.AllowsUnlimitedAttempts)
          {
            <span>Practice</span>
          }
          else
          {
            <span>@result.AttemptNumber of @result.Assignment.MaxAttempts</span>
          }
        </span>
      </div>
    </div>
  </div>
</div>

<!-- AI Summary -->
@if (!string.IsNullOrEmpty(result.AiSummary))
{
  <div class="card mb-4">
    <div class="card-body">
      <h6 class="mb-2"><i class="bx bx-comment-detail me-1 text-primary"></i> AI Summary</h6>
      <p class="mb-0">@result.AiSummary</p>
    </div>
  </div>
}

<!-- Per-question breakdown + teacher grading -->
<form method="post" asp-action="GradeSubmission" id="gradeForm">
  @Html.AntiForgeryToken()
  <input type="hidden" name="resultId" value="@result.Id" />
  <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl as string)" />
  <input type="hidden" name="assignmentId" value="@result.AssignmentId" />
  <input type="hidden" name="gradesJson" id="gradesJson" />

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><i class="bx bx-list-check me-2"></i>Question-by-Question Breakdown</h5>
    <small class="text-muted">Adjust the AI's grade below, then save.</small>
  </div>
  <div class="card-body p-0">
    @for (int i = 0; i < questions.Count; i++)
    {
      var q = questions[i];
      if (layout.IsStem[i])
      {
        @* A shared stem: context for the parts that follow. Nothing to grade here. *@
        <div class="p-3 bg-light border-start border-primary border-3 @(i > 0 ? "border-top" : "")">
          <span class="badge bg-label-primary mb-1">Question @layout.Labels[i] — shared question</span>
          <h6 class="mb-0 math-render">@q.Title</h6>
          @if (!string.IsNullOrEmpty(q.ImagePath))
          {
            <img src="@q.ImagePath" class="img-fluid rounded border mt-2 mb-1" style="max-height:220px;" alt="Diagram" />
          }
        </div>
        continue;
      }
      var answer = result.StudentAnswers.FirstOrDefault(a => a.QuestionIndex == i);
      var isCorrect = answer?.IsCorrect;
      var borderClass = isCorrect == true ? "border-start border-success border-3" :
                        isCorrect == false ? "border-start border-danger border-3" :
                        "border-start border-secondary border-3";

      var verdict    = SmartSchoolAI.Services.AiCostReport.Verdict(answer);
      var unfinished = answer is not null && SmartSchoolAI.Services.GradingService.IsUnfinished(answer);
      Model.AiCosts.TryGetValue(i, out var aiCost);
      var disputed   = verdict?.TranscriptionIssues.Where(t => t.Step is not null).Select(t => t.Step!.Value).ToHashSet() ?? new HashSet<int>();

      <div class="p-3 @borderClass @(i > 0 ? "border-top" : "")" id="q@(i)">
        <div class="d-flex align-items-start gap-3">
          <div>
            <span class="avatar avatar-sm">
              <span class="avatar-initial rounded-circle bg-label-@(isCorrect == true ? "success" : isCorrect == false ? "danger" : "secondary")">
                @layout.Labels[i]
              </span>
            </span>
          </div>
          <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="mb-0 math-render">@q.Title</h6>
                @if (!string.IsNullOrEmpty(q.ImagePath))
                {
                  <img src="@q.ImagePath" class="img-fluid rounded border mt-2 mb-1" style="max-height:220px;" alt="Diagram" />
                }
                <small class="text-muted">Type: @q.Type</small>
              </div>
              <div class="text-end">
                <span class="badge bg-label-@(isCorrect == true ? "success" : isCorrect == false ? "danger" : "secondary")">
                  @(isCorrect == true ? "Correct" : isCorrect == false ? "Incorrect" : "Not Evaluated")
                </span>
                @if (answer?.NeedsReview == true)
                {
                  <span class="badge bg-warning ms-1" data-bs-toggle="tooltip"
                        title="The AI could not confirm this grade — please check it yourself">
                    <i class="bx bx-error me-1"></i>Needs your review
                  </span>
                }
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="bg-lighter rounded p-2 mb-2">
                  <small class="text-muted d-block mb-1"><i class="bx bx-user me-1"></i>Student's Answer:</small>
                  <span class="@(isCorrect == false ? "text-danger" : "")">
                    @(string.IsNullOrEmpty(answer?.AnswerValue) ? "— No answer —" : answer.AnswerValue)
                  </span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="bg-lighter rounded p-2 mb-2">
                  <small class="text-muted d-block mb-1"><i class="bx bx-check-circle me-1"></i>Correct Answer:</small>
                  <span class="text-success fw-semibold">
                    @(string.IsNullOrEmpty(q.AnswerKey) ? "— N/A —" : q.AnswerKey)
                  </span>
                </div>
              </div>
            </div>

            @{
              var steps = result.StepResults.Where(s => s.QuestionIndex == i).OrderBy(s => s.StepNumber).ToList();
            }
            @if (answer?.NeedsReview == true && !string.IsNullOrWhiteSpace(answer.ReviewNote))
            {
              <div class="alert alert-warning py-2 px-3 mb-2 small">
                <i class="bx bx-error-circle me-1"></i>@answer.ReviewNote
              </div>
            }

            @if (!string.IsNullOrWhiteSpace(answer?.WorkText))
            {
              <div class="bg-lighter rounded p-2 mb-2">
                <small class="text-muted d-block mb-1">
                  <i class="bx bx-edit me-1"></i>Student's working:
                </small>
                <div class="math-render" style="white-space:pre-wrap; line-height:2;">@answer.WorkText</div>
              </div>
            }

            @if (!string.IsNullOrEmpty(answer?.SketchPath))
            {
              <div class="mb-2">
                <small class="text-muted d-block mb-1"><i class="bx bx-pencil me-1"></i>Student's drawing:</small>
                <a href="@answer.SketchPath" target="_blank" rel="noopener" title="Open full size">
                  <img src="@answer.SketchPath" class="img-fluid rounded border" style="max-height:480px;" alt="Student's drawing" />
                </a>
                @if (!string.IsNullOrWhiteSpace(answer.AiSummary))
                {
                  <div class="small text-muted mt-1"><i class="bx bx-bot me-1"></i>@answer.AiSummary</div>
                }
              </div>
            }
            else if (q.RequireDrawing)
            {
              <div class="small text-muted mb-2"><i class="bx bx-pencil me-1"></i>No drawing was submitted.</div>
            }

            @{
              var answerPhotos = SmartSchoolAI.Services.SubmissionMedia.Paths(answer?.ImagePath);
            }
            @if (answerPhotos.Any())
            {
              <div class="row mt-2">
                <div class="col-md-4 mb-2">
                  <small class="text-muted d-block mb-1">
                    <i class="bx bx-camera me-1"></i>Handwritten solution@(answerPhotos.Count > 1 ? $" ({answerPhotos.Count} pages)" : ""):
                  </small>
                  <div class="d-flex flex-column gap-2">
                    @foreach (var photo in answerPhotos)
                    {
                      <img src="@photo" class="img-fluid rounded border" alt="Solution photo" />
                    }
                  </div>
                </div>
                <div class="col-md-8">
                  @if (unfinished)
                  {
                    var pending = SmartSchoolAI.Services.GradingService.PendingSteps(answer!);
                    <small class="text-muted d-block mb-1"><i class="bx bx-list-ol me-1"></i>Student's steps (not marked yet):</small>
                    @foreach (var s in pending)
                    {
                      <div class="border rounded p-2 mb-1 small math-render" data-step="@s.Number">Step @s.Number: @s.Text</div>
                    }
                  }
                  else
                  {
                    <small class="text-muted d-block mb-1"><i class="bx bx-list-ol me-1"></i>Recognized steps:</small>
                    @foreach (var s in steps)
                    {
                      var ok = s.Status == ResultStatus.Correct;
                      var isDisputed = disputed.Contains(s.StepNumber);
                      <div class="border rounded p-2 mb-1 @(isDisputed ? "disputed-step" : "")" data-step="@s.StepNumber"
                           style="border-left:4px solid @(isDisputed ? "#ffab00" : ok ? "#71dd37" : "#ff3e1d") !important;">
                        <div class="small"><span aria-hidden="true">@(ok ? "✅" : "❌")</span> Step @s.StepNumber: <span class="math-render">@s.StepText</span></div>
                        @if (!ok && !string.IsNullOrEmpty(s.Explanation))
                        {
                          <div class="small text-muted mt-1">💡 @s.Explanation</div>
                        }
                        @foreach (var t in verdict?.TranscriptionIssues.Where(t => t.Step == s.StepNumber) ?? Enumerable.Empty<SmartSchoolAI.Services.AiMarkingService.TranscriptionIssue>())
                        {
                          <div class="small mt-1 text-warning fw-semibold" data-issue>
                            <i class="bx bx-error me-1" aria-hidden="true"></i>
                            On the photo: “@t.OnPhoto”, read as “@t.Transcribed”@(t.Certain ? "" : " (not certain)")@(t.MarksAffected is > 0 ? $" — {t.MarksAffected:0.##} mark(s) depend on it" : "").
                            @if (!string.IsNullOrWhiteSpace(t.Note)) { <span class="fw-normal">@t.Note</span> }
                          </div>
                        }
                      </div>
                    }
                  }
                  @if (verdict?.RecognizedSteps is { Count: > 0 } read)
                  {
                    <details class="mt-2 small" data-ocr>
                      <summary class="text-muted">As first read from the photo@(string.IsNullOrEmpty(verdict.RecognitionModel) ? "" : $" ({verdict.RecognitionModel})")</summary>
                      <ol class="mb-0 mt-1 ps-3">
                        @foreach (var r in read)
                        {
                          <li class="@(disputed.Contains(r.Number) ? "text-warning fw-semibold" : "")">
                            <span class="math-render">@r.Text</span>
                            @if (!string.IsNullOrWhiteSpace(r.CrossedOut)) { <span class="text-muted"> (crossed out: <s>@r.CrossedOut</s>)</span> }
                            @foreach (var u in r.Unclear) { <span class="badge bg-label-warning ms-1">unclear: @u.Fragment</span> }
                          </li>
                        }
                      </ol>
                    </details>
                  }
                </div>
              </div>
            }

            @if (verdict is { Criteria.Count: > 0 })
            {
              <div class="mt-2" data-criteria>
                <small class="text-muted d-block mb-1"><i class="bx bx-check-square me-1"></i>Marks by criterion (AI@(string.IsNullOrEmpty(verdict.Model) ? "" : $", {verdict.Model}")):</small>
                <div class="table-responsive">
                  <table class="table table-sm table-bordered mb-1 small">
                    <thead class="table-light"><tr><th>Criterion</th><th class="text-center">Marks</th><th>Why</th><th>Based on</th></tr></thead>
                    <tbody>
                      @foreach (var c in verdict.Criteria)
                      {
                        <tr class="@(c.Step is { } cs && disputed.Contains(cs) ? "table-warning" : "")">
                          <td>@c.Name</td>
                          <td class="text-center text-nowrap"><strong>@c.Awarded.ToString("0.##")</strong> / @c.MaxMarks.ToString("0.##")</td>
                          <td class="math-render">@c.Explanation</td>
                          <td class="math-render text-muted">@c.Evidence</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            }

            @if (unfinished || aiCost is not null)
            {
              <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small text-muted" data-ai-cost>
                @if (aiCost is not null)
                {
                  <span title="@string.Join("\n", aiCost.Lines.Select(l => $"{l.Stage} · {l.Model} · {l.InputTokens?.ToString() ?? "?"} in / {l.OutputTokens?.ToString() ?? "?"} out · {(l.Cost is { } lc ? $"${lc:0.#####}" : "no data")}{(l.Succeeded ? "" : $" · failed ({l.Failure})")}{(l.Shared ? " · shared with other answers" : "")}"))">
                    <i class="bx bx-coin-stack me-1" aria-hidden="true"></i>AI checking: @aiCost.Calls call@(aiCost.Calls == 1 ? "" : "s") ·
                    @aiCost.InputTokens.ToString("N0") in / @aiCost.OutputTokens.ToString("N0") out tokens · cost @aiCost.CostText@(aiCost.Shared ? " (one call shared by several answers)" : "")
                  </span>
                }
                @if (unfinished)
                {
                  <button type="submit" form="retry_@(i)" class="btn btn-xs btn-warning" data-retry>
                    <i class="bx bx-refresh me-1" aria-hidden="true"></i>Retry AI marking
                  </button>
                }
              </div>
            }

            @if (isCorrect == false && !string.IsNullOrEmpty(q.Explanation))
            {
              <div class="bg-label-info rounded p-2">
                <small class="text-muted d-block mb-1"><i class="bx bx-bulb me-1"></i>Explanation:</small>
                <span>@q.Explanation</span>
              </div>
            }

            @{
              // Not marked yet (the AI did not finish, or nothing to mark): the box stays empty, never a silent 0.
              var notMarked   = answer?.PointsAwarded is null && isCorrect is null;
              var gradePoints = notMarked ? "" : (answer?.PointsAwarded ?? (isCorrect == true ? q.MaxPoints : 0m))
                  .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
              var maxPoints = q.MaxPoints.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            }
            <!-- Teacher grading controls -->
            <div class="border-top mt-3 pt-3">
              <div class="row g-2 align-items-end">
                <div class="col-auto">
                  <label class="form-label small text-muted d-block mb-1">Grade</label>
                  <div class="btn-group" role="group">
                    <input type="radio" class="btn-check grade-correct" name="gc_@i" id="gcCorrect_@i"
                           value="true" data-idx="@i" @(isCorrect == true ? "checked" : "")>
                    <label class="btn btn-sm btn-outline-success" for="gcCorrect_@i"><i class="bx bx-check"></i></label>
                    <input type="radio" class="btn-check grade-correct" name="gc_@i" id="gcIncorrect_@i"
                           value="false" data-idx="@i" @(isCorrect == false ? "checked" : "")>
                    <label class="btn btn-sm btn-outline-danger" for="gcIncorrect_@i"><i class="bx bx-x"></i></label>
                  </div>
                </div>
                <div class="col-auto">
                  <label class="form-label small text-muted d-block mb-1">Marks (out of @maxPoints)</label>
                  <div class="input-group input-group-sm" style="width:130px;">
                    <input type="number" step="0.5" min="0" max="@maxPoints" class="form-control grade-points"
                           data-idx="@i" data-max="@maxPoints" value="@gradePoints" placeholder="@(notMarked ? "not marked" : "")">
                    <span class="input-group-text">/ @maxPoints</span>
                  </div>
                </div>
                <div class="col">
                  <label class="form-label small text-muted d-block mb-1">Comment to student</label>
                  <input type="text" class="form-control form-control-sm grade-comment"
                         data-idx="@i" placeholder="Optional feedback…" value="@(answer?.TeacherComment ?? "")">
                </div>
                @if (answer?.TeacherOverridden == true)
                {
                  <div class="col-auto">
                    <span class="badge bg-label-primary"><i class="bx bx-edit me-1"></i>Overridden</span>
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    }

    @if (!questions.Any())
    {
      <div class="p-4 text-center text-muted">No questions found in this assignment.</div>
    }
  </div>
</div>

@{
  var bonusValue = result.BonusPoints.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<!-- Grading footer -->
<div class="card mt-3 mb-4">
  <div class="card-body d-flex flex-wrap align-items-end justify-content-between gap-3">
    <div>
      <label class="form-label small text-muted d-block mb-1">
        Bonus points <span class="text-muted">(extra credit added to the total)</span>
      </label>
      <input type="number" step="0.5" min="0" name="bonusPoints" value="@bonusValue"
             class="form-control form-control-sm" style="width:120px;">
    </div>
    <div class="d-flex gap-2">
      <a href="/Assignments/Details/@result.AssignmentId" class="btn btn-outline-secondary">
        <i class="bx bx-arrow-back me-1"></i> Back
      </a>
      <button type="submit" class="btn btn-primary">
        <i class="bx bx-save me-1"></i> Save grades
      </button>
    </div>
  </div>
</div>
</form>

@* "Retry AI marking" forms live outside the grading form (forms cannot nest); each button points at its own. *@
@foreach (var a in result.StudentAnswers.Where(SmartSchoolAI.Services.GradingService.IsUnfinished))
{
  <form method="post" action="/Assignments/RetryAiMarking" id="retry_@(a.QuestionIndex)" class="d-none"
        onsubmit="var b=document.querySelector('[form=retry_@(a.QuestionIndex)]'); if(b){b.disabled=true; b.innerHTML='Marking…';}">
    @Html.AntiForgeryToken()
    <input type="hidden" name="resultId" value="@result.Id" />
    <input type="hidden" name="questionIndex" value="@a.QuestionIndex" />
    <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl as string)" />
  </form>
}
<style>
  .disputed-step { background: rgba(255, 171, 0, .08); }
  .btn-xs { padding: .15rem .45rem; font-size: .75rem; }
</style>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
<script>
  // Render LaTeX in question text, student answers and their working.
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof renderMathInElement !== 'function') return;
    document.querySelectorAll('.math-render').forEach(function (el) {
      renderMathInElement(el, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false },
          { left: '\\(', right: '\\)', display: false },
          { left: '\\[', right: '\\]', display: true }
        ],
        throwOnError: false
      });
    });
  });

  // Marking a question correct gives it its point and marking it incorrect takes the point back. Without this the
  // mark and the points disagree: a question shown as correct with 0 points leaves the student's score unchanged.
  document.querySelectorAll('.grade-correct').forEach(function (radio) {
    radio.addEventListener('change', function () {
      var points = document.querySelector('.grade-points[data-idx="' + radio.dataset.idx + '"]');
      if (!points || !radio.checked) return;
      var value = parseFloat(points.value) || 0;
      if (radio.value === 'true' && value === 0) points.value = points.dataset.max || '1';
      if (radio.value === 'false' && value > 0) points.value = '0';
    });
  });

  // Collect all per-question grade controls into the hidden gradesJson field
  // right before the form posts, so the controller receives one tidy array.
  document.getElementById('gradeForm').addEventListener('submit', function () {
    const rows = {};
    const rowFor = i => (rows[i] ??= { questionIndex: +i });

    document.querySelectorAll('.grade-correct:checked').forEach(el => {
      rowFor(el.dataset.idx).isCorrect = el.value === 'true';
    });
    document.querySelectorAll('.grade-points').forEach(el => {
      rowFor(el.dataset.idx).points = parseFloat(el.value) || 0;
    });
    document.querySelectorAll('.grade-comment').forEach(el => {
      rowFor(el.dataset.idx).comment = el.value.trim();
    });

    // A question the teacher left unmarked (no grade chosen, no marks typed) is not saved: an answer that is "not
    // marked yet" must not become a teacher's 0 just because the form was saved for another question.
    document.querySelectorAll('.grade-points').forEach(el => {
      const i = el.dataset.idx;
      if (el.value.trim() === '' && !document.querySelector('.grade-correct[data-idx="' + i + '"]:checked')) delete rows[i];
    });
    document.getElementById('gradesJson').value = JSON.stringify(Object.values(rows));
  });
</script>
}
