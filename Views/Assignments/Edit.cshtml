    dropLabel:   'Drop a PDF here',
    analyse:     'Analyse PDF',
    chipIcon:    'bx bx-file-pdf text-danger fs-5',
    accept:      '.pdf',
    spinner:     'AI is extracting and categorising questions'
  },
  image: {
    icon:        'bx bx-image-alt text-info me-2',
    title:       'Upload questions from Image / Photo',
    desc:        'Take a photo or scan of your exam sheet. The AI will recognise and extract all questions automatically.',
    dropLabel:   'Drop an image here (JPG, PNG, WEBP, HEIC)',
    analyse:     'Analyse Image',
    chipIcon:    'bx bx-image text-info fs-5',
