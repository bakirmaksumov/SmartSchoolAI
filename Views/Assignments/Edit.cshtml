    document.getElementById('fileChipIcon').className    = cfg.chipIcon;
    document.getElementById('pdfFileInput').accept       = cfg.accept;
  }
}

// Enable the Generate button only when a topic has been entered.
function genValidate() {
  const topic = document.getElementById('genTopic').value.trim();
  document.getElementById('pdfAnalyseBtn').disabled = topic.length === 0;
}

function pdfReset() {
  pdfFile = null;
  pdfParsedQuestions = [];
  pdfShowStep(1);
  const fi = document.getElementById('pdfFileInput');   if (fi) fi.value = '';
  const fc = document.getElementById('pdfFileChip');    if (fc) fc.classList.add('d-none');
  const fe = document.getElementById('pdfUploadError'); if (fe) fe.classList.add('d-none');
  const ab = document.getElementById('pdfAnalyseBtn');  if (ab) ab.disabled = true;
  const dz = document.getElementById('pdfDropZone');    if (dz) dz.classList.remove('border-primary', 'bg-light');
  const iw = document.getElementById('imgPreviewWrap'); if (iw) iw.classList.add('d-none');
}

function pdfShowStep(n) {
  const s1 = document.getElementById('pdfStep1');   if (s1) s1.classList.toggle('d-none', n !== 1);
  const s2 = document.getElementById('pdfStep2');   if (s2) s2.classList.toggle('d-none', n !== 2);
  const s3 = document.getElementById('pdfStep3');   if (s3) s3.classList.toggle('d-none', n !== 3);
  const f1 = document.getElementById('pdfFooter1'); if (f1) f1.classList.toggle('d-none', n !== 1);
  const f3 = document.getElementById('pdfFooter3'); if (f3) f3.classList.toggle('d-none', n !== 3);
}

function pdfDragOver(ev) {
  ev.preventDefault();
  document.getElementById('pdfDropZone').classList.add('border-primary', 'bg-light');
}
function pdfDragLeave(ev) {
  document.getElementById('pdfDropZone').classList.remove('border-primary', 'bg-light');
}
function pdfDrop(ev) {
  ev.preventDefault();
  pdfDragLeave(ev);
  const f = ev.dataTransfer?.files?.[0];
  if (f) pdfSetFile(f);
}
function pdfFileSelected(input) {
  if (input.files?.[0]) pdfSetFile(input.files[0]);
}
function pdfSetFile(f) {
  const ext = f.name.split('.').pop().toLowerCase();
  const imgExts = ['jpg','jpeg','png','webp','heic','heif','bmp','gif'];
  if (importMode === 'pdf' && ext !== 'pdf') {
    pdfShowError('Only PDF files are supported.');
    return;
  }
  if (importMode === 'image' && !imgExts.includes(ext)) {
    pdfShowError('Please choose an image file (JPG, PNG, WEBP, HEIC, etc.).');
    return;
  }
  pdfFile = f;
  document.getElementById('pdfFileName').textContent = f.name + ' (' + (f.size / 1024).toFixed(0) + ' KB)';
  document.getElementById('pdfFileChip').classList.remove('d-none');
  document.getElementById('pdfUploadError').classList.add('d-none');
  document.getElementById('pdfAnalyseBtn').disabled = false;
  // Show inline image preview when in image mode
  const iw = document.getElementById('imgPreviewWrap');
  const ip = document.getElementById('imgPreview');
  if (importMode === 'image' && iw && ip) {
    const reader = new FileReader();
    reader.onload = e => { ip.src = e.target.result; iw.classList.remove('d-none'); };
    reader.readAsDataURL(f);
  } else if (iw) {
    iw.classList.add('d-none');
  }
}
function pdfClearFile() {
  pdfFile = null;
  document.getElementById('pdfFileInput').value = '';
  document.getElementById('pdfFileChip').classList.add('d-none');
  document.getElementById('pdfAnalyseBtn').disabled = true;
}
function pdfShowError(msg) {
  const el = document.getElementById('pdfUploadError');
  el.textContent = msg;
  el.classList.remove('d-none');
}

let pollTimer = null;

function _stopPolling() {
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
}

function _setProgress(percent) {
  const bar = document.getElementById('analysingProgressBar');
  const pct = document.getElementById('analysingPercent');
  if (bar) { bar.style.width = percent + '%'; bar.setAttribute('aria-valuenow', percent); }
  if (pct) pct.textContent = percent + '%';
}

// Starts a background generation/import job on the server, then polls
// GenerationProgress every 500ms — the percentage is a time-based estimate
// tied to the real background call, so it only ever reaches 100% once that
// call has actually finished (or failed).
async function _pollJob(jobId) {
  _stopPolling();
  pollTimer = setInterval(async () => {
    try {
      const res  = await fetch('/Assignments/GenerationProgress/' + jobId);
      const data = await res.json();

      _setProgress(data.percent ?? 0);

      if (data.status === 'running') return;

      _stopPolling();

      if (data.status === 'error') {
        pdfShowStep(1);
        pdfShowError(data.error || 'Something went wrong.');
        return;
      }

      pdfParsedQuestions = data.questions ?? [];

      // An empty review list ("0 questions found" + "Add all 0 questions") explains nothing,
      // so go back to the first step with a message instead.
      if (pdfParsedQuestions.length === 0) {
        pdfShowStep(1);
        pdfShowError('No questions were found. Try a different file, a smaller section of it, or adjust your request.');
        return;
      }

      pdfBuildReviewList();
      pdfShowStep(3);
    } catch (err) {
      _stopPolling();
      pdfShowStep(1);
      pdfShowError('Network error: ' + err.message);
    }
  }, 500);
}

async function pdfStartAnalysis() {
  if (importMode === 'generate') { await genStartGeneration(); return; }
  if (!pdfFile) return;
  pdfShowStep(2);
  _setProgress(0);

  const fd = new FormData();
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  if (token) fd.append('__RequestVerificationToken', token);

  let endpoint;
  if (importMode === 'image') {
    fd.append('image', pdfFile);
    endpoint = '/Assignments/ImportFromImageStart/@a.Id';
  } else {
    fd.append('pdf', pdfFile);
    endpoint = '/Assignments/ImportFromPdfStart/@a.Id';
  }

  try {
    const res  = await fetch(endpoint, { method: 'POST', body: fd });
    const data = await res.json();
    if (data.error) { pdfShowStep(1); pdfShowError(data.error); return; }
    await _pollJob(data.jobId);
  } catch (err) {
    pdfShowStep(1);
    pdfShowError('Network error: ' + err.message);
  }
}

// Collects the generation form, starts the AI job, then hands the polled
// results to the shared review pipeline (identical to import).
async function genStartGeneration() {
  const topic = document.getElementById('genTopic').value.trim();
  if (!topic) { genValidate(); return; }
  pdfShowStep(2);
  _setProgress(0);

  const types = Array.from(document.querySelectorAll('.gen-type:checked')).map(c => c.value);
  if (types.length === 0) types.push('MultipleChoice', 'ShortAnswer');

  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  const fd = new FormData();
  if (token) fd.append('__RequestVerificationToken', token);
  fd.append('topic',      topic);
  fd.append('count',      document.getElementById('genCount').value || '5');
  fd.append('difficulty', document.getElementById('genDifficulty').value);
  fd.append('gradeLevel', document.getElementById('genGrade').value);
  fd.append('types',      types.join(', '));

  try {
    const res  = await fetch('/Assignments/GenerateQuestionsStart/@a.Id', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.error) { pdfShowStep(1); pdfShowError(data.error); return; }
    await _pollJob(data.jobId);
  } catch (err) {
    pdfShowStep(1);
    pdfShowError('Network error: ' + err.message);
  }
}

function pdfEscapeHtml(s) {
  return (s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function pdfBuildReviewList() {
  const list = document.getElementById('pdfQuestionList');
  list.innerHTML = '';
  pdfParsedQuestions.forEach((q, i) => {
    const badge = { MultipleChoice: 'primary', SingleChoice: 'success', ShortAnswer: 'info', OpenText: 'secondary' }[q.type] ?? 'dark';
    const item = document.createElement('label');
    item.className = 'list-group-item list-group-item-action d-flex gap-3 align-items-start py-2';
    item.innerHTML = `
      <input class="form-check-input mt-1 flex-shrink-0" type="checkbox" checked value="${i}">
      <div class="flex-grow-1">
        <div class="d-flex gap-2 align-items-center mb-1">
          <span class="badge bg-${badge}">${q.type}</span>
          <span class="badge bg-light text-dark">${q.difficulty ?? 'Medium'}</span>
          ${q.number ? '<span class="text-muted small">Q' + q.number + (q.groupKey && q.part ? '(' + pdfEscapeHtml(q.part) + ')' : '') + '</span>' : ''}
          ${q.groupKey ? '<span class="badge bg-label-success">part of a shared question</span>' : ''}
        </div>
        ${q.groupKey && q.stem ? '<div class="small text-muted border-start ps-2 mb-1">Shared: ' + pdfEscapeHtml(q.stem) + '</div>' : ''}
        <div class="small fw-semibold">${pdfEscapeHtml(q.title)}</div>
        ${q.options?.length ? '<div class="text-muted" style="font-size:.78rem;">' + q.options.slice(0,4).map(pdfEscapeHtml).join(' &bull; ') + '</div>' : ''}
        ${q.hasDiagram ? '<div class="alert alert-warning py-1 px-2 small mt-1 mb-0"><i class="bx bx-image me-1"></i>Likely has a diagram this import couldn\'t carry over' + (q.diagramHint ? ': ' + pdfEscapeHtml(q.diagramHint) : '') + ' — attach it after adding.</div>' : ''}
        ${q.validationWarning ? '<div class="alert alert-danger py-1 px-2 small mt-1 mb-0"><i class="bx bx-error-circle me-1"></i>Incorrect question: ' + pdfEscapeHtml(q.validationWarning) + '</div>' : ''}
      </div>`;
    list.appendChild(item);
  });
  const n = pdfParsedQuestions.length;
  document.getElementById('pdfCountLabel').textContent = n + ' question' + (n !== 1 ? 's' : '') + ' found';
  document.getElementById('pdfAddBtn').textContent = 'Add all ' + n + ' questions';
  renderMath(list);   // show any $…$ math in the review list rendered

  // update button label on check change
  list.addEventListener('change', () => {
    const sel = list.querySelectorAll('input:checked').length;
    document.getElementById('pdfAddBtn').textContent = 'Add selected (' + sel + ')';
  });
}

function pdfBackToStep1() { pdfShowStep(1); }

async function pdfAddSelected() {
  const list    = document.getElementById('pdfQuestionList');
  const checked = Array.from(list.querySelectorAll('input:checked')).map(cb => +cb.value);
  const toAdd   = checked.map(i => pdfParsedQuestions[i]);
  if (!toAdd.length) return;

  document.getElementById('pdfAddBtn').disabled = true;
  document.getElementById('pdfAddBtn').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding…';

  // Add questions one by one via the existing AddQuestion endpoint
  const typeMap = { MultipleChoice: 1, SingleChoice: 4, ShortAnswer: 0, OpenText: 3 };
  const token   = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

  const sharedParents = {};   // groupKey -> id of the shared question already added for it

  async function addQuestionJson(obj) {
    const fd = new FormData();
    fd.append('questionJson', JSON.stringify(obj));
    fd.append('__RequestVerificationToken', token);
    await fetch('/Assignments/AddQuestion/@a.Id', { method: 'POST', body: fd });
  }

  for (const q of toAdd) {
    // Parts the import clearly identified share one parent question (the stem and its diagram), added once
    // before the first part. Questions the import was unsure about were not grouped and are added as listed.
    let groupId = null;
    if (q.groupKey && q.stem) {
      if (!sharedParents[q.groupKey]) {
        const sharedHint = toAdd.filter(p => p.groupKey === q.groupKey && p.hasDiagram).map(p => p.diagramHint).find(Boolean) ?? '';
        sharedParents[q.groupKey] = genUUID();
        await addQuestionJson({
          id:         sharedParents[q.groupKey],
          title:      q.stem,
          type:       0,
          difficulty: q.difficulty ?? 'Medium',
          answerKey:  '',
          options:    [],
          diagramHint: toAdd.some(p => p.groupKey === q.groupKey && p.hasDiagram) ? sharedHint : null
        });
      }
      groupId = sharedParents[q.groupKey];
    }

    // Controller expects a single "questionJson" field with a JSON string
    const questionObj = {
      id:                genUUID(),
      groupId:           groupId,
      title:             q.title,
      type:              typeMap[q.type] ?? 0,
      difficulty:        q.difficulty ?? 'Medium',
      answerKey:         q.answerKey ?? '',
      options:           q.options ?? [],
      diagramHint:       (q.hasDiagram && !groupId) ? (q.diagramHint ?? '') : null,   // a shared diagram belongs to the shared question
      validationWarning: q.validationWarning ?? null
    };
    const fd = new FormData();
    fd.append('questionJson', JSON.stringify(questionObj));
    fd.append('__RequestVerificationToken', token);
    await fetch('/Assignments/AddQuestion/@a.Id', { method: 'POST', body: fd });
  }

  pdfModalInstance?.hide();
  location.reload();
}

// ── preview as student ────────────────────────────────────────────────────
function previewAsStudent() {
  window.open('/Assignments/Preview/@a.Id', '_blank');
}

// ── settings type → deadline required toggle ──────────────────────────────
(function() {
  const sel = document.getElementById('settingsTypeSelect');
  const req = document.getElementById('settingsDeadlineReq');
  const inp = document.getElementById('settingsDeadlineInput');
  if (!sel) return;
  function update() {
    const hw = sel.value === '1';
    req.classList.toggle('d-none', !hw);
    inp.required = hw;
  }
  sel.addEventListener('change', update);
  update();
})();

// ══ CONTENT LIBRARY MODAL ════════════════════════════════════════════════

let libModalInstance = null;
let libAllQuestions = [];
let libSubjects = [];
let libDebounceTimer = null;

// Opens the modal and loads questions
function openLibraryModal() {
  closeAddPanel();
  libModalInstance = new bootstrap.Modal(document.getElementById('libraryModal'));
  libModalInstance.show();
  document.getElementById('libraryModal').addEventListener('shown.bs.modal', function onShown() {
    this.removeEventListener('shown.bs.modal', onShown);
    libLoadQuestions();
  });
}

// Load questions from API with current filters
async function libLoadQuestions() {
  const loading = document.getElementById('libLoading');
  const empty   = document.getElementById('libEmpty');
  const list    = document.getElementById('libQuestionList');
  
  loading.classList.remove('d-none');
  empty.classList.add('d-none');
  list.classList.add('d-none');

  const params = new URLSearchParams();
  const subject = document.getElementById('libSubject').value;
  const grade = document.getElementById('libGrade').value;
  const difficulty = document.getElementById('libDifficulty').value;
  const search = document.getElementById('libSearch').value.trim();

  if (subject) params.append('subject', subject);
  if (grade) params.append('grade', grade);
  if (difficulty) params.append('difficulty', difficulty);
  if (search) params.append('search', search);

  try {
    const res = await fetch('/ContentLibrary/GetQuestions?' + params.toString());
    const data = await res.json();
    libAllQuestions = data;

    // Extract unique subjects for filter dropdown
    const uniqueSubjects = [...new Set(data.map(q => q.subject).filter(Boolean))].sort();
    if (uniqueSubjects.length > 0 && libSubjects.length === 0) {
      libSubjects = uniqueSubjects;
      libPopulateSubjects();
    }

    loading.classList.add('d-none');
    
    if (data.length === 0) {
      empty.classList.remove('d-none');
      libUpdateCounter(0);
    } else {
      list.classList.remove('d-none');
      libRenderQuestionList(data);
      libUpdateCounter(data.length);
    }
  } catch (err) {
    loading.classList.add('d-none');
    empty.classList.remove('d-none');
    alert('Failed to load questions: ' + err.message);
  }
}

// Populate subjects dropdown
function libPopulateSubjects() {
  const sel = document.getElementById('libSubject');
  const currentVal = sel.value;
  sel.innerHTML = '<option value="">All Subjects</option>';
  libSubjects.forEach(s => {
    const opt = document.createElement('option');
    opt.value = s;
    opt.textContent = s;
    if (s === currentVal) opt.selected = true;
    sel.appendChild(opt);
  });
}

// Debounced search
function libDebounceLoad() {
  clearTimeout(libDebounceTimer);
  libDebounceTimer = setTimeout(() => libLoadQuestions(), 400);
}

// Render question list
function libRenderQuestionList(questions) {
  const list = document.getElementById('libQuestionList');
  list.innerHTML = '';

  questions.forEach(q => {
    const typeMap = {
      'ShortAnswer': { label: 'Text/Numeric', color: 'primary', code: 0 },
      'MultipleChoice': { label: 'Multiple choice', color: 'primary', code: 1 },
      'OpenText': { label: 'Open text', color: 'secondary', code: 3 },
      'SingleChoice': { label: 'Single choice', color: 'success', code: 4 },
      'Graphing': { label: 'Graphing', color: 'info', code: 5 },
      'GeometryDrawing': { label: 'Geometry drawing', color: 'warning', code: 6 },
      'NumberLine': { label: 'Number line', color: 'secondary', code: 7 },
      'DotPlot': { label: 'Dot plot', color: 'danger', code: 8 },
      'TableCheck': { label: 'Table check', color: 'primary', code: 9 },
      'TableText': { label: 'Table text', color: 'secondary', code: 10 },
      'VerticalOperation': { label: 'Vertical operation', color: 'info', code: 11 },
      'Protractor': { label: 'Protractor', color: 'danger', code: 12 },
      'FractionModel': { label: 'Rectangular fraction model', color: 'success', code: 13 }
    };

    const typeInfo = typeMap[q.type] || { label: q.type, color: 'dark', code: 0 };
    const diffColor = { Easy: 'success', Medium: 'warning', Hard: 'danger' }[q.difficulty] || 'secondary';

    const options = q.options ? JSON.parse(q.options) : [];
    const optionsHtml = options.length > 0
      ? '<div class="text-muted" style="font-size:.78rem;">' + options.slice(0, 4).map(pdfEscapeHtml).join(' • ') + '</div>'
      : '';

    const item = document.createElement('label');
    item.className = 'list-group-item list-group-item-action d-flex gap-3 align-items-start py-3 lib-question-item';
    item.innerHTML = `
      <input class="form-check-input mt-1 flex-shrink-0 lib-q-checkbox" type="checkbox" value="${q.id}" onchange="libUpdateSelection()">
      <div class="flex-grow-1">
        <div class="d-flex gap-2 align-items-center mb-1 flex-wrap">
          <span class="badge bg-${typeInfo.color}">${pdfEscapeHtml(typeInfo.label)}</span>
          <span class="badge bg-${diffColor}">${pdfEscapeHtml(q.difficulty)}</span>
          ${q.subject ? '<span class="badge bg-light text-dark">' + pdfEscapeHtml(q.subject) + '</span>' : ''}
          ${q.gradeLevel ? '<span class="badge bg-light text-dark">Grade ' + pdfEscapeHtml(String(q.gradeLevel)) + '</span>' : ''}
        </div>
        <div class="fw-semibold mb-1">${pdfEscapeHtml(q.title)}</div>
        ${optionsHtml}
      </div>`;
    list.appendChild(item);
  });
}

// Update counter and badges
function libUpdateCounter(total) {
  document.getElementById('libCounter').textContent = total + ' question' + (total !== 1 ? 's' : '');
}

// Update selection state
function libUpdateSelection() {
  const checkboxes = document.querySelectorAll('.lib-q-checkbox');
  const checked = Array.from(checkboxes).filter(cb => cb.checked);
  const selectedCount = checked.length;
  const totalCount = checkboxes.length;

  const badge = document.getElementById('libSelectedBadge');
  const addBtn = document.getElementById('libAddBtn');
  const addCount = document.getElementById('libAddCount');
  const footerCount = document.getElementById('libFooterCount');
  const selectAll = document.getElementById('libSelectAll');

  if (selectedCount > 0) {
    badge.classList.remove('d-none');
    badge.textContent = selectedCount + ' selected';
    addBtn.disabled = false;
    addCount.textContent = selectedCount;
    footerCount.textContent = selectedCount + ' question' + (selectedCount !== 1 ? 's' : '') + ' selected';
  } else {
    badge.classList.add('d-none');
    addBtn.disabled = true;
    addCount.textContent = '0';
    footerCount.textContent = 'Select questions to add';
  }

  // Update select all checkbox state
  if (selectedCount === totalCount && totalCount > 0) {
    selectAll.checked = true;
    selectAll.indeterminate = false;
  } else if (selectedCount > 0) {
    selectAll.checked = false;
    selectAll.indeterminate = true;
  } else {
    selectAll.checked = false;
    selectAll.indeterminate = false;
  }
}

// Toggle all checkboxes
function libToggleAll() {
  const selectAll = document.getElementById('libSelectAll');
  const checkboxes = document.querySelectorAll('.lib-q-checkbox');
  checkboxes.forEach(cb => cb.checked = selectAll.checked);
  libUpdateSelection();
}

// Clear all filters
function libClearFilters() {
  document.getElementById('libSearch').value = '';
  document.getElementById('libSubject').value = '';
  document.getElementById('libGrade').value = '';
  document.getElementById('libDifficulty').value = '';
  libLoadQuestions();
}

// Add selected questions to assignment
async function libAddSelected() {
  const checkboxes = document.querySelectorAll('.lib-q-checkbox:checked');
  const questionIds = Array.from(checkboxes).map(cb => cb.value);
  
  if (questionIds.length === 0) return;

  const addBtn = document.getElementById('libAddBtn');
  addBtn.disabled = true;
  addBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding…';

  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
  const fd = new FormData();
  fd.append('questionIds', JSON.stringify(questionIds));
  fd.append('__RequestVerificationToken', token);

  try {
    const res = await fetch('/Assignments/ImportFromLibrary/@a.Id', { method: 'POST', body: fd });
    const data = await res.json();
    
    if (data.error) {
      alert('Error: ' + data.error);
      addBtn.disabled = false;
      addBtn.innerHTML = '<i class="bx bx-plus me-1"></i>Add selected (<span id="libAddCount">' + questionIds.length + '</span>)';
      return;
    }

    libModalInstance?.hide();
    location.reload();
  } catch (err) {
    alert('Failed to add questions: ' + err.message);
    addBtn.disabled = false;
    addBtn.innerHTML = '<i class="bx bx-plus me-1"></i>Add selected (<span id="libAddCount">' + questionIds.length + '</span>)';
  }
}
</script>
}
