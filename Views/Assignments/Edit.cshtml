@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/contrib/auto-render.min.js"></script>
<script>
// crypto.randomUUID requires a secure context (HTTPS or localhost).
// Fall back to a manual UUIDv4 generator when served over plain HTTP.
function genUUID() {
  if (window.crypto && typeof window.crypto.randomUUID === 'function') {
    return window.crypto.randomUUID();
  }
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
    const r = Math.random() * 16 | 0;
    const v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}

// ── Math rendering (KaTeX) ────────────────────────────────────────────────
const MATH_DELIMS = [
  { left: '$$', right: '$$', display: true },
  { left: '$',  right: '$',  display: false },
  { left: '\\(', right: '\\)', display: false },
  { left: '\\[', right: '\\]', display: true }
];

function renderMath(el) {
  if (el && typeof renderMathInElement === 'function') {
    renderMathInElement(el, { delimiters: MATH_DELIMS, throwOnError: false });
  }
}

// Render all question cards once the page is ready.
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.math-render').forEach(renderMath);
});

// ── Math input helpers (edit drawer) ──────────────────────────────────────

// Inserts a LaTeX snippet at the cursor. Auto-wraps in $…$ when the cursor is
// not already inside a math span, so teachers don't have to think about mode.
function mathInsert(before, after) {
  const ta = document.getElementById('eq_title');
  if (!ta) return;
  const start = ta.selectionStart, end = ta.selectionEnd;
  const val = ta.value;
  const selected = val.slice(start, end);

  const dollarsBefore = (val.slice(0, start).match(/\$/g) || []).length;
  const inMath = dollarsBefore % 2 === 1;

  const open  = inMath ? before : '$' + before;
  const close = inMath ? after  : after + '$';
  const insert = open + selected + close;

  ta.value = val.slice(0, start) + insert + val.slice(end);
  const caret = start + open.length + selected.length;
  ta.focus();
  ta.setSelectionRange(caret, caret);
  mathPreview();
}

// Wraps the current selection (or the caret) in $…$.
function mathWrap() {
  const ta = document.getElementById('eq_title');
  if (!ta) return;
  const start = ta.selectionStart, end = ta.selectionEnd;
  const val = ta.value;
  const selected = val.slice(start, end);
  ta.value = val.slice(0, start) + '$' + selected + '$' + val.slice(end);
  const caret = start + 1 + selected.length;
  ta.focus();
  ta.setSelectionRange(caret, caret);
  mathPreview();
}

// Live preview of the question text with math rendered.
function mathPreview() {
  const ta = document.getElementById('eq_title');
  const box = document.getElementById('eq_preview');
  if (!ta || !box) return;
  const text = ta.value.trim();
  if (!text) { box.innerHTML = '<span class="text-muted">Preview appears here…</span>'; return; }
  box.textContent = text;
  renderMath(box);
}

// ── type definitions ─────────────────────────────────────────────────────
const SCRATCH_TYPES = [
  { val:0,  label:'Text/Numeric',             icon:'bx-text',              color:'primary' },
  { val:4,  label:'Single choice',            icon:'bx-check-circle',      color:'success' },
  { val:1,  label:'Multiple choice',          icon:'bx-list-check',        color:'primary' },
  { val:5,  label:'Graphing',                 icon:'bx-line-chart',        color:'info' },
  { val:6,  label:'Geometry drawing',         icon:'bx-shape-triangle',    color:'warning' },
  { val:7,  label:'Number line',              icon:'bx-right-arrow-alt',   color:'secondary' },
  { val:8,  label:'Dot plot',                 icon:'bx-dots-horizontal-rounded', color:'danger' },
  { val:9,  label:'Table check',              icon:'bx-grid-alt',          color:'primary' },
  { val:10, label:'Table text',               icon:'bx-table',             color:'secondary' },
  { val:11, label:'Vertical operation',       icon:'bx-list-ol',           color:'info' },
  { val:12, label:'Protractor',               icon:'bx-compass',           color:'danger' },
  { val:13, label:'Rectangular fraction model', icon:'bx-grid',            color:'success' },
];

// ── build type grid ──────────────────────────────────────────────────────
(function buildGrid() {
  const grid = document.getElementById('scratchTypeGrid');
  SCRATCH_TYPES.forEach(t => {
    const col = document.createElement('div');
    col.className = 'col-4';
    col.innerHTML = `
      <button type="button" class="btn btn-outline-primary w-100 text-start d-flex align-items-center gap-2 p-2"
              style="font-size:.82rem;" onclick="openScratch(${t.val},'${t.label}')">
        <i class="bx ${t.icon} text-${t.color}" style="font-size:1.1rem;flex-shrink:0;"></i>
        <span>${t.label}</span>
      </button>`;
    grid.appendChild(col);
  });
})();

