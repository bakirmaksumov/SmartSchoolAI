@model SmartSchoolAI.ViewModels.AssignmentEditViewModel
@using System.Text.Json
@{
    var a = Model.Assignment;
    ViewData["Title"] = a.Title;
    var questions = JsonSerializer.Deserialize<List<JsonElement>>(a.Questions ?? "[]") ?? new();
    var classes = Model.Classes;
    // Allows deep-linking straight to the settings tab (/Assignments/Edit/{id}?tab=settings)
    var activeTab = Context.Request.Query["tab"].ToString() == "settings" ? "settings" : "questions";
    var canEditQuestions = Model.CanEditQuestions;
    var statusColor = a.Status switch {
        SmartSchoolAI.Models.AssignmentStatus.Draft    => "secondary",
        SmartSchoolAI.Models.AssignmentStatus.Active   => "success",
        SmartSchoolAI.Models.AssignmentStatus.Closed   => "warning",
        _                                              => "dark"
    };
}

<!-- ── TOP BAR ──────────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center gap-3 mb-3 py-2 border-bottom">
    <a href="/Assignments" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
        <i class="bx bx-arrow-back"></i> Back
    </a>
    <span class="fw-semibold text-truncate" style="max-width:260px;" id="assignTitleDisplay">@a.Title</span>
    <span class="badge bg-@statusColor">@a.Status</span>
    <span class="badge bg-success d-none" id="savedBadge"><i class="bx bx-check me-1"></i>Saved</span>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="previewAsStudent()">
            <i class="bx bx-show me-1"></i>Preview as student
        </button>
        @if (a.Status == SmartSchoolAI.Models.AssignmentStatus.Draft)
        {
            <form method="post" asp-action="Publish" asp-route-id="@a.Id" class="d-inline"
                  onsubmit="return confirm('Assign this to your students? They can start straight away. You can still fix questions until someone submits — after the first submission the questions are locked.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-primary">
                    Assign <i class="bx bx-right-arrow-alt ms-1"></i>
                </button>
            </form>
        }
    </div>
</div>

<!-- ── TABS ─────────────────────────────────────────────────────────────── -->
<ul class="nav nav-underline mb-4" id="assignTabs">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "questions" ? "active" : "") fw-semibold" href="#" data-tab="questions"
           onclick="switchTab('questions',this);return false;">
            Questions
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "settings" ? "active" : "") fw-semibold" href="#" data-tab="settings"
           onclick="switchTab('settings',this);return false;">
            Settings
        </a>
    </li>
</ul>

<!-- ══ TAB: QUESTIONS ════════════════════════════════════════════════════ -->
<div id="tabQuestions" class="@(activeTab == "questions" ? "" : "d-none")">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            @if (!canEditQuestions)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2">
                    <i class="bx bx-lock-alt fs-5"></i>
                    <div>
                        <strong>Questions are locked.</strong>
                        Students have already submitted answers. Changing the questions now would
                        mis-align the answers already graded, so this set is frozen.
                    </div>
                </div>
            }

            <!-- Empty state -->
            <div id="emptyState" class="card @(questions.Any() ? "d-none" : "")">
                <div class="card-body text-center py-5">
                    <i class="bx bx-question-mark" style="font-size:3.5rem;color:#696cff;"></i>
                    <h5 class="mt-3 fw-semibold">There are no questions in your assignment yet.</h5>
                    <button class="btn btn-primary mt-2" onclick="openAddPanel()">
                        <i class="bx bx-plus me-1"></i>Add questions
                    </button>
                </div>
            </div>

            <!-- Questions list -->
            @{
                // Group the flat list into top-level questions + their subpoints
                // (e.g. "2" with children "2a"/"2b"), purely for display/labelling —
                // storage stays flat; grouping is derived from groupId each render.
                string? IdOf(JsonElement e) => e.TryGetProperty("id", out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
                string? GroupIdOf(JsonElement e) => e.TryGetProperty("groupId", out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

                var idToIndex = new Dictionary<string, int>();
                for (int i = 0; i < questions.Count; i++)
                {
                    var qid = IdOf(questions[i]);
                    if (!string.IsNullOrEmpty(qid)) idToIndex[qid] = i;
                }

                var topLevel = new List<int>();
                var childrenOf = new Dictionary<int, List<int>>();
                for (int i = 0; i < questions.Count; i++)
                {
                    if (string.IsNullOrEmpty(GroupIdOf(questions[i]))) topLevel.Add(i);
                }
                for (int i = 0; i < questions.Count; i++)
                {
                    var gid = GroupIdOf(questions[i]);
                    if (!string.IsNullOrEmpty(gid) && idToIndex.TryGetValue(gid, out var parentIdx))
                    {
                        if (!childrenOf.ContainsKey(parentIdx)) childrenOf[parentIdx] = new List<int>();
                        childrenOf[parentIdx].Add(i);
                    }
                }

                var renderItems = new List<(int idx, string label, bool isChild, int topLevelPos)>();
                for (int t = 0; t < topLevel.Count; t++)
                {
                    var headerIdx = topLevel[t];
                    renderItems.Add((headerIdx, (t + 1).ToString(), false, t));
                    if (childrenOf.TryGetValue(headerIdx, out var kids))
                    {
                        for (int c = 0; c < kids.Count; c++)
                            renderItems.Add((kids[c], $"{t + 1}{(char)('a' + c)}", true, t));
                    }
                }
            }
            <div id="questionsList">
                @foreach (var item in renderItems)
                {
                    var idx = item.idx;
                    var q = questions[idx];
                    var qTitle = q.TryGetProperty("title", out var t) ? t.GetString() ?? "Untitled" : "Untitled";
                    var qType  = q.TryGetProperty("type", out var ty)
                        ? (ty.ValueKind == System.Text.Json.JsonValueKind.String
                            ? ty.GetString() ?? ""
                            : ty.ToString())
                        : "";
                    var qDiff  = q.TryGetProperty("difficulty", out var d)
                        ? (d.ValueKind == System.Text.Json.JsonValueKind.String
                            ? d.GetString() ?? "Medium"
                            : d.ToString())
                        : "Medium";

                    // Map numeric type codes to readable labels
                    var typeLabels = new Dictionary<string, string> {
                        {"0","Text/Numeric"},{"1","Multiple choice"},{"2","Fill in the blank"},
                        {"3","Open text"},{"4","Single choice"},{"5","Graphing"},
                        {"6","Geometry drawing"},{"7","Number line"},{"8","Dot plot"},
                        {"9","Table check"},{"10","Table text"},{"11","Vertical operation"},
                        {"12","Protractor"},{"13","Rectangular fraction model"}
                    };
                    if (typeLabels.ContainsKey(qType)) qType = typeLabels[qType];

                    // Extract options and answer key
                    var qOptions = new List<string>();
                    if (q.TryGetProperty("options", out var opts) && opts.ValueKind == System.Text.Json.JsonValueKind.Array)
                    {
                        foreach (var o in opts.EnumerateArray())
                            qOptions.Add(o.GetString() ?? "");
                    }
                    var qAnswer = q.TryGetProperty("answerKey", out var ak)
                        ? (ak.ValueKind == System.Text.Json.JsonValueKind.String ? ak.GetString() ?? "" : ak.ToString())
                        : "";
                    var qImagePath = q.TryGetProperty("imagePath", out var qip) && qip.ValueKind == System.Text.Json.JsonValueKind.String
                        ? qip.GetString() : null;
                    var qAnswerKeyImagePath = q.TryGetProperty("answerKeyImagePath", out var qakip) && qakip.ValueKind == System.Text.Json.JsonValueKind.String
                        ? qakip.GetString() : null;
                    var qRequireWork = q.TryGetProperty("requireWork", out var rw) && rw.ValueKind == System.Text.Json.JsonValueKind.True;
                    var qDiagramHint = q.TryGetProperty("diagramHint", out var qdh) && qdh.ValueKind == System.Text.Json.JsonValueKind.String
                        ? qdh.GetString() : null;
                    var qValidationWarning = q.TryGetProperty("validationWarning", out var qvw) && qvw.ValueKind == System.Text.Json.JsonValueKind.String
                        ? qvw.GetString() : null;

                    <div class="card mb-3 question-card @(item.isChild ? "ms-4 border-start border-primary border-3" : "")" data-index="@idx">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-label-secondary">Q@(item.label)</span>
                                        <span class="badge bg-label-primary">@qType</span>
                                        <span class="badge bg-label-@(qDiff=="Easy"?"success":qDiff=="Hard"?"danger":"warning")">@qDiff</span>
                                    </div>
                                    <div class="fw-semibold mb-1 math-render">@qTitle</div>

                                    @if (!string.IsNullOrEmpty(qImagePath))
                                    {
                                        <img src="@qImagePath" class="img-fluid rounded border mt-1 mb-2" style="max-height:180px;" />
                                    }

                                    @if (qOptions.Any())
                                    {
                                        <div class="mt-2">
                                            @foreach (var (opt, oi) in qOptions.Select((o,i) => (o,i)))
                                            {
                                                var letter = (char)('A' + oi);
                                                var isCorrect = !string.IsNullOrEmpty(qAnswer) &&
                                                    (qAnswer.Trim().Equals(opt.Trim(), StringComparison.OrdinalIgnoreCase)
                                                     || qAnswer.Trim().Equals(letter.ToString(), StringComparison.OrdinalIgnoreCase));
                                                <div class="d-flex align-items-center gap-2 py-1">
                                                    <span class="badge rounded-pill @(isCorrect ? "bg-success" : "bg-label-secondary")"
                                                          style="width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:.75rem;">
                                                        @letter
                                                    </span>
                                                    <span class="small math-render @(isCorrect ? "fw-semibold text-success" : "")">@opt</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(qAnswer) && !qOptions.Any())
                                    {
                                        <div class="mt-2 small text-muted">
                                            <i class="bx bx-check-circle text-success me-1"></i>Answer: <span class="fw-semibold">@qAnswer</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(qAnswerKeyImagePath))
                                    {
                                        <div class="mt-1 small text-muted">
                                            <i class="bx bx-image text-primary me-1"></i>Reference solution image attached
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(qDiagramHint) && string.IsNullOrEmpty(qImagePath))
                                    {
                                        <div class="alert alert-warning py-1 px-2 small mt-2 mb-0">
                                            <i class="bx bx-image me-1"></i>Likely needs a diagram this import couldn't carry over: @qDiagramHint
                                            — attach it via <strong>Edit</strong>.
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(qValidationWarning))
                                    {
                                        <div class="alert alert-danger py-1 px-2 small mt-2 mb-0 d-flex align-items-center justify-content-between gap-2">
                                            <span><i class="bx bx-error-circle me-1"></i>Incorrect question: @qValidationWarning</span>
                                            @if (canEditQuestions)
                                            {
                                                <form method="post" asp-action="DismissValidationWarning" asp-route-id="@a.Id" class="d-inline flex-shrink-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="index" value="@idx" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Dismiss</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    <div class="mt-2 d-flex align-items-center gap-2">
                                        <div class="form-check form-switch mb-0">
                                            @if (canEditQuestions)
                                            {
                                                <input type="checkbox" class="form-check-input" role="switch"
                                                       id="requireWork_@idx" @(qRequireWork ? "checked" : null)
                                                       onchange="document.getElementById('requireWorkForm_@idx').submit();" />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="form-check-input" role="switch"
                                                       id="requireWork_@idx" @(qRequireWork ? "checked" : null) disabled />
                                            }
                                            <label class="form-check-label small text-muted" for="requireWork_@idx">
                                                Require students to show their work
                                            </label>
                                        </div>
                                        @if (canEditQuestions)
                                        {
                                            <form id="requireWorkForm_@idx" method="post" asp-action="ToggleRequireWork" asp-route-id="@a.Id" class="d-none">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@idx" />
                                            </form>
                                        }
                                    </div>
                                    @if (canEditQuestions && !item.isChild)
                                    {
                                        <form method="post" asp-action="AddSubpoint" asp-route-id="@a.Id" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="parentIndex" value="@idx" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bx bx-plus me-1"></i>Add subpoint
                                            </button>
                                        </form>
                                    }
                                </div>
                                @if (canEditQuestions)
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @if (!item.isChild)
                                        {
                                            <form method="post" asp-action="MoveQuestion" asp-route-id="@a.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@idx" />
                                                <input type="hidden" name="direction" value="-1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move up"
                                                        @(item.topLevelPos == 0 ? "disabled" : null)>
                                                    <i class="bx bx-up-arrow-alt"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-action="MoveQuestion" asp-route-id="@a.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@idx" />
                                                <input type="hidden" name="direction" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move down"
                                                        @(item.topLevelPos == topLevel.Count - 1 ? "disabled" : null)>
                                                    <i class="bx bx-down-arrow-alt"></i>
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Edit"
                                                onclick="openEditDrawer(@idx)">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                        <form method="post" asp-action="DuplicateQuestion" asp-route-id="@a.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="index" value="@idx" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Duplicate">
                                                <i class="bx bx-copy"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="RemoveQuestion" asp-route-id="@a.Id"
                                              onsubmit="return confirm('@(!item.isChild && childrenOf.ContainsKey(idx) ? "Remove this question and all its subpoints?" : "Remove this question?")')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="index" value="@idx" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Add more button (shown when list has items) -->
            @if (canEditQuestions)
            {
                <div id="addMoreBtn" class="@(questions.Any() ? "" : "d-none") text-center mt-2 mb-4">
                    <button class="btn btn-outline-primary" onclick="openAddPanel()">
                        <i class="bx bx-plus me-1"></i>Add questions
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ══ TAB: SETTINGS ═════════════════════════════════════════════════════ -->
<div id="tabSettings" class="@(activeTab == "settings" ? "" : "d-none")">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><h6 class="mb-0"><i class="bx bx-cog me-2"></i>Assignment Settings</h6></div>
                <div class="card-body">
                    <form method="post" asp-action="SaveSettings" asp-route-id="@a.Id" id="settingsForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="title" value="@a.Title" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description / Instructions</label>
                            <textarea class="form-control" name="description" rows="3">@a.Description</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Class <span class="text-danger">*</span></label>
                                <select class="form-select" name="classId" required>
                                    @foreach (var cls in classes)
                                    {
                                        if (cls.Id == a.ClassId)
                                        {
                                            <option value="@cls.Id" selected>@cls.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@cls.Id">@cls.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Type</label>
                                <select class="form-select" name="type" id="settingsTypeSelect">
                                    @if (a.Type == SmartSchoolAI.Models.AssignmentType.ClassroomPractice)
                                    {
                                        <option value="0" selected>Classroom Practice</option>
                                        <option value="1">Homework</option>
                                    }
                                    else
                                    {
                                        <option value="0">Classroom Practice</option>
                                        <option value="1" selected>Homework</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3" id="settingsDeadlineGroup">
                                <label class="form-label fw-semibold">Deadline <span class="text-danger" id="settingsDeadlineReq">*</span></label>
                                <input type="datetime-local" class="form-control" name="deadline"
                                       value="@(a.Deadline.HasValue ? a.Deadline.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                                       id="settingsDeadlineInput" />
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end pb-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="allowLateSubmission"
                                           value="true"
                                           id="settingsLateCheck" @(a.AllowLateSubmission ? "checked" : "") />
                                    <label class="form-check-label" for="settingsLateCheck">Allow late submissions</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Grading scale</label>
                                <select class="form-select" name="gradingType">
                                    @foreach (var g in Enum.GetValues<SmartSchoolAI.Models.GradingType>())
                                    {
                                        var label = g switch {
                                            SmartSchoolAI.Models.GradingType.Percentage => "Percentage (85%)",
                                            SmartSchoolAI.Models.GradingType.Letter     => "Letter (A–F)",
                                            SmartSchoolAI.Models.GradingType.PassFail   => "Pass / Fail",
                                            _                                            => "GPA (4.0)"
                                        };
                                        if (g == a.GradingType)
                                        {
                                            <option value="@g" selected>@label</option>
                                        }
                                        else
                                        {
                                            <option value="@g">@label</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Pass mark (%)</label>
                                <input type="number" class="form-control" name="passThreshold"
                                       value="@a.PassThreshold" min="1" max="100" />
                                <div class="form-text">Score needed to pass this assignment.</div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Attempts</label>
                                <input type="number" class="form-control" name="maxAttempts"
                                       value="@a.MaxAttempts" min="0" max="50" />
                                <div class="form-text">0 = unlimited retries.</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="antiCopyPaste"
                                           value="true"
                                           id="settingsPasteCheck" @(a.AntiCopyPaste ? "checked" : "") />
                                    <label class="form-check-label" for="settingsPasteCheck">
                                        Block pasting into answer fields
                                        <span class="text-muted small d-block">
                                            Discourages pasting answers straight from a chatbot. A soft deterrent —
                                            a determined student can still get around it.
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="allowSolutionReveal"
                                           value="true"
                                           id="settingsRevealCheck" @(a.AllowSolutionReveal ? "checked" : "") />
                                    <label class="form-check-label" for="settingsRevealCheck">
                                        Let the AI tutor reveal full solutions
                                        <span class="text-muted small d-block">
                                            When off, the tutor gives escalating hints but never states the final answer.
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="allowInstantFeedback"
                                           value="true"
                                           id="settingsInstantCheck" @(a.AllowInstantFeedback ? "checked" : "") />
                                    <label class="form-check-label" for="settingsInstantCheck">
                                        Let students check each answer while solving
                                        <span class="text-muted small d-block">
                                            Shows right/wrong per question straight away. Always on for classroom
                                            practice; leave off for graded homework so answers can't be guessed.
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <a href="/Assignments" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="bx bx-save me-1"></i>Save Settings</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ ADD QUESTIONS PANEL (slide-in from right) ═════════════════════════ -->
<div id="addPanelBackdrop" class="position-fixed top-0 start-0 w-100 h-100 d-none"
     style="background:rgba(0,0,0,.35);z-index:1040;" onclick="closeAddPanel()"></div>

<div id="addPanel" class="position-fixed top-0 end-0 h-100 bg-white shadow-lg d-flex flex-column"
     style="width:520px;max-width:96vw;z-index:1050;transform:translateX(100%);transition:transform .25s ease;">
    <div class="d-flex align-items-center justify-content-between p-4 border-bottom">
        <h5 class="mb-0 fw-bold">Content library</h5>
        <button class="btn-close" onclick="closeAddPanel()"></button>
    </div>
    <div class="p-4 overflow-auto flex-grow-1">

        <!-- Generate with AI (hero action) -->
        <button type="button" class="btn btn-primary w-100 mb-2 py-2" onclick="openImportModal('generate')">
            <i class="bx bx-bulb me-1"></i>Generate with AI
        </button>

        <!-- Add from content library -->
        <button type="button" class="btn btn-outline-primary w-100 mb-4 py-2" onclick="openLibraryModal()">
            <i class="bx bx-book-open me-1"></i>Add from content library
        </button>

        <!-- Create from scratch -->
        <h6 class="fw-bold mb-3">Create from scratch</h6>
        <div class="row g-2" id="scratchTypeGrid">
            <!-- filled by JS from SCRATCH_TYPES -->
        </div>

        <!-- Import from PDF / Image -->
        <div class="border-top mt-4 pt-3 d-flex flex-column gap-2">
            <button class="btn btn-outline-secondary w-100" onclick="openImportModal('pdf')">
                <i class="bx bx-file-pdf me-1 text-danger"></i>Import from PDF
            </button>
