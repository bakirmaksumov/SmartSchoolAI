// ── Edit question drawer ──────────────────────────────────────────────────
const QUESTIONS_DATA = @Html.Raw(a.Questions ?? "[]");
let eqCurrentIndex = -1;
let eqImagePath = null;
let eqAnswerKeyImagePath = null;

function openEditDrawer(idx) {
  eqCurrentIndex = idx;
  const q = QUESTIONS_DATA[idx];
  if (!q) return;

  // Populate fields
  document.getElementById('eq_title').value      = q.title      ?? '';
  document.getElementById('eq_answerKey').value  = q.answerKey  ?? '';
  document.getElementById('eq_difficulty').value = q.difficulty ?? 'Medium';
  document.getElementById('eq_type').value       = String(q.type ?? 0);
  document.getElementById('eq_saveError').classList.add('d-none');

  // Populate options + math preview
  eqRenderOptions(q.options ?? []);
  eqTypeChanged();
  mathPreview();

  // Populate attached images
  eqImagePath = q.imagePath ?? null;
  eqSetImagePreview('eq_imagePreviewWrap', 'eq_imagePreview', eqImagePath);
  document.getElementById('eq_imageFile').value = '';
  document.getElementById('eq_imageUploadStatus').textContent = '';

  eqAnswerKeyImagePath = q.answerKeyImagePath ?? null;
  eqSetImagePreview('eq_answerKeyImagePreviewWrap', 'eq_answerKeyImagePreview', eqAnswerKeyImagePath);
  document.getElementById('eq_answerKeyImageFile').value = '';
  document.getElementById('eq_answerKeyImageUploadStatus').textContent = '';

  // Open drawer
  document.getElementById('editPanelBackdrop').classList.remove('d-none');
  document.getElementById('editPanel').style.transform = 'translateX(0)';
}

function closeEditDrawer() {
  document.getElementById('editPanelBackdrop').classList.add('d-none');
  document.getElementById('editPanel').style.transform = 'translateX(100%)';
  eqCurrentIndex = -1;
}

// ── Question image attachments (diagram + answer-key reference) ───────────

function eqSetImagePreview(wrapId, imgId, path) {
  const wrap = document.getElementById(wrapId);
  const img  = document.getElementById(imgId);
  if (path) {
    img.src = path;
    wrap.classList.remove('d-none');
  } else {
    img.src = '';
    wrap.classList.add('d-none');
  }
}

function eqRemoveImage() {
  eqImagePath = null;
  eqSetImagePreview('eq_imagePreviewWrap', 'eq_imagePreview', null);
  document.getElementById('eq_imageFile').value = '';
}

function eqRemoveAnswerKeyImage() {
  eqAnswerKeyImagePath = null;
  eqSetImagePreview('eq_answerKeyImagePreviewWrap', 'eq_answerKeyImagePreview', null);
  document.getElementById('eq_answerKeyImageFile').value = '';
}

// Uploads immediately on file selection. `kind` is 'diagram' or 'answerkey' — picks
// the endpoint and which stashed path/preview/status elements get updated.
async function eqUploadFile(input, kind) {
  const file = input.files && input.files[0];
  if (!file) return;

  const isAnswerKey = kind === 'answerkey';
  const statusEl = document.getElementById(isAnswerKey ? 'eq_answerKeyImageUploadStatus' : 'eq_imageUploadStatus');
  const endpoint = isAnswerKey ? 'UploadAnswerKeyImage' : 'UploadQuestionImage';

  if (eqCurrentIndex < 0) {
    statusEl.textContent = 'Save the question once first, then attach an image.';
    input.value = '';
    return;
  }

  const original = QUESTIONS_DATA[eqCurrentIndex] ?? {};
  const questionId = original.id;
  if (!questionId) {
    statusEl.textContent = 'This question needs to be saved once before attaching an image.';
    input.value = '';
    return;
  }

  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
  const fd = new FormData();
  fd.append('questionId', questionId);
  fd.append('file', file);
  fd.append('__RequestVerificationToken', token);

  statusEl.textContent = 'Uploading…';

  try {
    const res = await fetch(`/Assignments/${endpoint}/@a.Id`, { method: 'POST', body: fd });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Upload failed.');

    if (isAnswerKey) {
      eqAnswerKeyImagePath = data.path;
      eqSetImagePreview('eq_answerKeyImagePreviewWrap', 'eq_answerKeyImagePreview', eqAnswerKeyImagePath);
    } else {
      eqImagePath = data.path;
      eqSetImagePreview('eq_imagePreviewWrap', 'eq_imagePreview', eqImagePath);
    }
    statusEl.textContent = '';
  } catch (err) {
    statusEl.textContent = 'Upload failed: ' + err.message;
  } finally {
    input.value = '';
  }
}

function eqTypeChanged() {
  const t = parseInt(document.getElementById('eq_type').value);
  const isChoice = t === 1 || t === 4; // MultipleChoice or SingleChoice
  document.getElementById('eq_optionsSection').classList.toggle('d-none', !isChoice);
}

function eqRenderOptions(opts) {
  const container = document.getElementById('eq_optionsList');
  container.innerHTML = '';
  opts.forEach((o, i) => {
    const letter = String.fromCharCode(65 + i);
    const row = document.createElement('div');
    row.className = 'input-group mb-2';
    row.innerHTML = `
      <span class="input-group-text fw-bold">${letter}</span>
      <input type="text" class="form-control eq-option" value="${o.replace(/"/g, '&quot;')}" placeholder="Option ${letter}">
      <button type="button" class="btn btn-outline-danger" onclick="eqRemoveOption(this)"><i class="bx bx-x"></i></button>`;
    container.appendChild(row);
  });
}

function eqAddOption() {
  const container = document.getElementById('eq_optionsList');
  const count = container.querySelectorAll('.eq-option').length;
  const letter = String.fromCharCode(65 + count);
  const row = document.createElement('div');
  row.className = 'input-group mb-2';
  row.innerHTML = `
    <span class="input-group-text fw-bold">${letter}</span>
    <input type="text" class="form-control eq-option" placeholder="Option ${letter}">
    <button type="button" class="btn btn-outline-danger" onclick="eqRemoveOption(this)"><i class="bx bx-x"></i></button>`;
  container.appendChild(row);
  eqRelabelOptions();
}

function eqRemoveOption(btn) {
  btn.closest('.input-group').remove();
  eqRelabelOptions();
}

function eqRelabelOptions() {
  document.querySelectorAll('#eq_optionsList .input-group').forEach((row, i) => {
    const letter = String.fromCharCode(65 + i);
    row.querySelector('.input-group-text').textContent = letter;
    row.querySelector('.eq-option').placeholder = `Option ${letter}`;
  });
}

async function eqSave() {
  if (eqCurrentIndex < 0) return;

  const title = document.getElementById('eq_title').value.trim();
  if (!title) {
    const err = document.getElementById('eq_saveError');
    err.textContent = 'Question text is required.';
    err.classList.remove('d-none');
    return;
  }

  const type       = parseInt(document.getElementById('eq_type').value);
  const difficulty = document.getElementById('eq_difficulty').value;
  const answerKey  = document.getElementById('eq_answerKey').value.trim();
  const options    = Array.from(document.querySelectorAll('#eq_optionsList .eq-option'))
                         .map(i => i.value.trim()).filter(Boolean);

  // Preserve fields this form doesn't expose — an id/groupId/requireWork
  // dropped here would silently un-group a subpoint or reset its toggle.
  const original = QUESTIONS_DATA[eqCurrentIndex] ?? {};
  const questionObj = {
    id:                 original.id ?? genUUID(),
    title,
    type,
    difficulty,
    answerKey,
    options,
    imagePath:          eqImagePath,
    answerKeyImagePath: eqAnswerKeyImagePath,
    requireWork:        original.requireWork ?? false,
    groupId:            original.groupId ?? null,
    // A diagram hint is only useful until the real image is attached; a
    // validation warning is only useful until the teacher has reviewed and
    // fixed the question here — both are resolved by this save.
    diagramHint:        eqImagePath ? null : (original.diagramHint ?? null),
    validationWarning:  null
  };

  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
  const fd = new FormData();
  fd.append('index', eqCurrentIndex);
  fd.append('questionJson', JSON.stringify(questionObj));
  fd.append('__RequestVerificationToken', token);

  const btn = document.querySelector('#editPanel .btn-primary');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

  try {
    const res = await fetch('/Assignments/UpdateQuestion/@a.Id', { method: 'POST', body: fd });
    if (!res.ok) throw new Error(await res.text());
    closeEditDrawer();
    location.reload();
  } catch (err) {
    const errEl = document.getElementById('eq_saveError');
    errEl.textContent = 'Save failed: ' + err.message;
    errEl.classList.remove('d-none');
    btn.disabled = false;
    btn.innerHTML = '<i class="bx bx-save me-1"></i>Save changes';
  }
}

