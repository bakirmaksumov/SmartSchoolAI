@model SmartSchoolAI.ViewModels.StudentStatsViewModel
@{
    var a = Model.Assignment;
    ViewData["Title"] = Model.Student.FullName + " — " + a.Title;
    var latestSubmitted = Model.Attempts.FirstOrDefault(r => r.IsSubmitted);
}

<!-- ── TOP BAR ──────────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center gap-3 mb-3 py-2 border-bottom">
    <a href="/Assignments/Details/@a.Id" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
        <i class="bx bx-arrow-back"></i> Back
    </a>
    <div class="avatar avatar-sm">
        <span class="avatar-initial rounded-circle bg-label-primary">@Model.Student.FullName[0]</span>
    </div>
    <div>
        <span class="fw-semibold d-block">@Model.Student.FullName</span>
        <span class="text-muted small">@a.Title</span>
    </div>
</div>

@if (Model.Enrollment.StartDateOverride.HasValue || Model.Enrollment.DueDateOverride.HasValue)
{
    <div class="alert alert-info d-flex align-items-center gap-2 py-2">
        <i class="bx bx-calendar-edit"></i>
        <span class="small">
            This student has a custom schedule —
            Start: <strong>@(Model.Enrollment.StartDateOverride?.ToString("dd MMM yyyy HH:mm") ?? "task default")</strong>,
            Due: <strong>@(Model.Enrollment.DueDateOverride?.ToString("dd MMM yyyy HH:mm") ?? "task default")</strong>
        </span>
    </div>
}

@if (!Model.Attempts.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bx bx-time-five" style="font-size:3rem;color:#a1acb8;"></i>
            <h6 class="mt-3 fw-semibold">No submissions yet</h6>
            <p class="text-muted mb-0">@Model.Student.FullName hasn't started this assignment.</p>
        </div>
    </div>
}
else
{
    <!-- ── Overview cards ───────────────────────────────────────────────── -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Latest score</div>
                    @if (latestSubmitted is not null)
                    {
                        <div class="display-6 fw-bold text-@(a.IsPass(latestSubmitted.Score) ? "success" : "danger")">@latestSubmitted.Score%</div>
                        <span class="badge bg-@(a.IsPass(latestSubmitted.Score) ? "success" : "danger")">@a.FormatGrade(latestSubmitted.Score)</span>
                    }
                    else
                    {
                        <div class="display-6 fw-bold text-muted">—</div>
                        <span class="badge bg-label-secondary">In progress</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Attempts used</div>
                    <div class="display-6 fw-bold">@Model.Attempts.Count(r => r.IsSubmitted)@(a.AllowsUnlimitedAttempts ? "" : " / " + a.MaxAttempts)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Best score</div>
                    @{
                        var submitted = Model.Attempts.Where(r => r.IsSubmitted).ToList();
                        var best = submitted.Any() ? submitted.Max(r => r.Score) : (int?)null;
                    }
                    <div class="display-6 fw-bold">@(best?.ToString() ?? "—")@(best.HasValue ? "%" : "")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Attempt history ──────────────────────────────────────────────── -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bx bx-history me-2"></i>Attempt history</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Attempt</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td>@attempt.AttemptNumber</td>
                            <td>
                                @if (attempt.IsSubmitted)
                                {
                                    <span class="badge bg-@(a.IsPass(attempt.Score) ? "success" : "danger")">@a.FormatGrade(attempt.Score)</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">In progress</span>
                                }
                            </td>
                            <td>@(attempt.IsSubmitted ? attempt.Score + "%" : "—")</td>
                            <td class="small text-muted">@(attempt.IsSubmitted ? attempt.SubmittedAt.ToString("dd MMM yyyy HH:mm") : "—")</td>
                            <td>
                                @if (attempt.IsSubmitted)
                                {
                                    <a href="/Assignments/SubmissionDetail?resultId=@attempt.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-show me-1"></i>View answers
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── Per-question breakdown (latest submitted attempt) ───────────── -->
    @if (Model.QuestionStats.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bx bx-bar-chart-alt-2 me-2"></i>Question Performance</h5>
                <small class="text-muted">@Model.Student.FullName's result on their most recent submitted attempt.</small>
            </div>
            <div class="card-body">
                @foreach (var s in Model.QuestionStats)
                {
                    var rateColor = s.SolveRate < 0 ? "secondary" : s.SolveRate >= 100 ? "success" : "danger";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="text-truncate" style="max-width:70%;">
                                <span class="badge bg-label-secondary me-1">Q@(s.Index + 1)</span>
                                <span class="small">@s.Title</span>
                            </div>
                            <div class="small text-muted">
                                @if (s.SolveRate < 0)
                                {
                                    <span>Not answered</span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-@rateColor">@(s.SolveRate >= 100 ? "Correct" : "Incorrect")</span>
                                }
                            </div>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar bg-@rateColor" style="width:@(s.SolveRate < 0 ? 0 : s.SolveRate)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
