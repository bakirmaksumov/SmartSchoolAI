@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script src="~/js/content-library-create.js" asp-append-version="true"></script>
@if (defaultType.HasValue)
{
<script>
// Auto-select the question type when opened from assignment editor
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.querySelector('.type-opt[data-val="@defaultType"]');
  if (btn) btn.click();
});
</script>
}
@if (inIframe)
{
<style>
  /* In iframe mode: remove outer page padding/chrome */
  body { background: #fff !important; }
  .content-wrapper { padding: 0 !important; }
  .content-footer, #layout-menu, #layout-navbar, .layout-overlay { display:none !important; }
  .layout-page { margin: 0 !important; padding: 0 !important; }
  .container-xxl { max-width: 100% !important; padding: 16px !important; }
</style>
}
}
