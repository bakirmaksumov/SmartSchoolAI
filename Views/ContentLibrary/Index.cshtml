@model List<SmartSchoolAI.Models.Question>
@{
    ViewData["Title"] = "Content Library";
    var subjects     = (List<string>)(ViewBag.Subjects ?? new List<string>());
    var assignmentId = ViewBag.AssignmentId as Guid?;
    var pickerMode   = assignmentId.HasValue;
}

<div class="row mb-4 align-items-center">
  <div class="col">
    @if (pickerMode)
    {
      <a href="/Assignments/Edit/@assignmentId" class="btn btn-sm btn-outline-secondary me-2">
        <i class="bx bx-arrow-back me-1"></i>Back to assignment
      </a>
      <h4 class="fw-bold py-3 mb-0 d-inline-block">
        <span class="text-muted fw-light">Add from</span> Content Library
      </h4>
    }
    else
    {
      <h4 class="fw-bold py-3 mb-0">
        <span class="text-muted fw-light">SmartSchool AI /</span> Content Library
      </h4>
    }
  </div>
  <div class="col-auto">
    <a href="/ContentLibrary/Create@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-primary">
      <i class="bx bx-plus me-1"></i> @(pickerMode ? "Create new question" : "Add Question")
    </a>
  </div>
</div>

<!-- Filters -->
<div class="card mb-4">
  <div class="card-body">
    <form method="get" class="row g-3 align-items-end">
      @if (pickerMode)
      {
        <input type="hidden" name="assignmentId" value="@assignmentId" />
      }
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bx bx-search"></i></span>
          <input type="text" class="form-control" name="search"
                 value="@ViewBag.CurrentSearch" placeholder="Search questions..." />
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Subject</label>
        <select class="form-select" name="subject">
          <option value="">All subjects</option>
          @foreach (var s in subjects)
          {
            if (ViewBag.CurrentSubject == s)
            {
              <option value="@s" selected>@s</option>
            }
            else
            {
              <option value="@s">@s</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Grade</label>
        <select class="form-select" name="grade">
          <option value="">All grades</option>
          @for (int g = 1; g <= 12; g++)
          {
            if (ViewBag.CurrentGrade?.ToString() == g.ToString())
            {
              <option value="@g" selected>Grade @g</option>
            }
            else
            {
              <option value="@g">Grade @g</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Difficulty</label>
        <select class="form-select" name="difficulty">
          <option value="">All levels</option>
          @foreach (var (val, label) in new[] { ("Easy","🌶 Easy"), ("Medium","🌶🌶 Medium"), ("Hard","🌶🌶🌶 Hard") })
          {
            if (ViewBag.CurrentDifficulty == val)
            {
              <option value="@val" selected>@label</option>
            }
            else
            {
              <option value="@val">@label</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <i class="bx bx-filter-alt me-1"></i> Filter
        </button>
        <a href="/ContentLibrary" class="btn btn-outline-secondary" title="Clear filters">
          <i class="bx bx-x"></i>
        </a>
      </div>
    </form>
  </div>
</div>

@if (pickerMode)
{
  <div class="alert alert-primary d-flex align-items-center gap-2 mb-4 py-2">
    <i class="bx bx-info-circle fs-5"></i>
    <span>Select questions to add to your assignment, or <a href="/ContentLibrary/Create?assignmentId=@assignmentId" class="fw-semibold">create a new one</a>.</span>
  </div>
}

@if (!Model.Any())
{
  <div class="card">
    <div class="card-body text-center py-5">
      <i class="bx bx-book-open" style="font-size:3rem; color:#696cff;"></i>
      <h5 class="mt-3">No questions yet</h5>
      <p class="text-muted">Build your library by adding reusable questions.</p>
      <a href="/ContentLibrary/Create@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-primary">
        <i class="bx bx-plus me-1"></i> Add First Question
      </a>
    </div>
  </div>
}
else
{
  <div class="card">
    <div class="card-header d-flex align-items-center justify-content-between py-3">
      <span class="text-muted small">
        <strong>@Model.Count</strong> question@(Model.Count != 1 ? "s" : "") found
      </span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:42%">Question</th>
            <th>Type</th>
            <th>Subject / Grade</th>
            <th>Difficulty</th>
            <th>Answer</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var q in Model)
          {
            var (typeIcon, typeLabel) = q.Type switch
            {
              SmartSchoolAI.Models.QuestionType.ShortAnswer    => ("bx-text",    "Short Answer"),
              SmartSchoolAI.Models.QuestionType.MultipleChoice => ("bx-list-ul", "Multiple Choice"),
              SmartSchoolAI.Models.QuestionType.OpenText       => ("bx-edit",    "Open Text"),
              SmartSchoolAI.Models.QuestionType.MathExpression => ("bx-math",    "Math"),
              _ => ("bx-question-mark", q.Type.ToString())
            };
            var (diffColor, diffLabel, diffEmoji) = q.Difficulty switch
            {
              SmartSchoolAI.Models.DifficultyLevel.Easy   => ("success", "Easy",   "🌶"),
              SmartSchoolAI.Models.DifficultyLevel.Medium => ("warning", "Medium", "🌶🌶"),
              SmartSchoolAI.Models.DifficultyLevel.Hard   => ("danger",  "Hard",   "🌶🌶🌶"),
              _ => ("secondary", q.Difficulty.ToString(), "")
            };
            <tr>
              <td>
                <div class="fw-semibold">@q.Title</div>
                @if (!string.IsNullOrEmpty(q.Explanation))
                {
                  <small class="text-muted">
                    @(q.Explanation.Length > 70 ? q.Explanation[..70] + "…" : q.Explanation)
                  </small>
                }
              </td>
              <td>
                <span class="badge bg-label-secondary">
                  <i class="bx @typeIcon me-1"></i>@typeLabel
                </span>
              </td>
              <td>
                @if (q.Subject != null)
                {
                  <span class="d-block fw-semibold small">@q.Subject</span>
                }
                @if (q.GradeLevel.HasValue)
                {
                  <small class="text-muted">Grade @q.GradeLevel</small>
                }
              </td>
              <td>
                <span class="badge bg-label-@diffColor">@diffEmoji @diffLabel</span>
              </td>
              <td>
                <code class="text-success fw-semibold small">@q.AnswerKey</code>
              </td>
              <td>
                <div class="d-flex gap-1 align-items-center">
                  @if (pickerMode)
                  {
                    <form method="post" action="/ContentLibrary/AttachToAssignment">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="questionId"   value="@q.Id" />
                      <input type="hidden" name="assignmentId" value="@assignmentId" />
                      <button type="submit" class="btn btn-sm btn-primary" title="Add to assignment">
                        <i class="bx bx-plus me-1"></i>Add
                      </button>
                    </form>
                  }
                  <a href="/ContentLibrary/Edit/@q.Id"
                     class="btn btn-sm btn-icon btn-outline-primary" title="Edit">
                    <i class="bx bx-edit"></i>
                  </a>
                  <form method="post" action="/ContentLibrary/Delete/@q.Id"
                        onsubmit="return confirm('Delete this question?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-icon btn-outline-danger" title="Delete">
                      <i class="bx bx-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}
