@model List<SmartSchoolAI.Models.Question>
@{
    ViewData["Title"] = "Content Library";
    var subjects     = (List<string>)(ViewBag.Subjects ?? new List<string>());
    var assignmentId = ViewBag.AssignmentId as Guid?;
    var pickerMode   = assignmentId.HasValue;
    var pageInfo     = ViewBag.Page as SmartSchoolAI.ViewModels.PageInfo ?? new SmartSchoolAI.ViewModels.PageInfo { Total = Model.Count };
    var hereUrl      = Context.Request.Path + Context.Request.QueryString;
    var syllabusLabels  = ViewBag.SyllabusLabels as Dictionary<Guid, SmartSchoolAI.Services.SyllabusService.TopicLabel> ?? new();
    var syllabusCatalog = ViewBag.SyllabusCatalog as List<SmartSchoolAI.Services.SyllabusService.CatalogVersion> ?? new();
    var curVersion   = ViewBag.CurrentSyllabusVersion as Guid?;
    var curComponent = ViewBag.CurrentSyllabusComponent as Guid?;
    var curTopic     = ViewBag.CurrentSyllabusTopic as Guid?;
    // A chosen topic or component also tells which version it belongs to.
    var spVersion = syllabusCatalog.FirstOrDefault(v => v.Id == curVersion)
        ?? syllabusCatalog.FirstOrDefault(v => v.Components.Any(c => c.Id == curComponent || c.Topics.Any(t => t.Id == curTopic)))
        ?? (syllabusCatalog.Count == 1 ? syllabusCatalog[0] : null);
    var spComponent = spVersion?.Components.FirstOrDefault(c => c.Id == curComponent || (curComponent == null && c.Topics.Any(t => t.Id == curTopic)));
    var spTopics = spComponent is not null
        ? spComponent.Topics.Select(t => (t, c: spComponent)).ToList()
        : spVersion?.Components.SelectMany(c => c.Topics.Select(t => (t, c))).ToList() ?? new();
    var filtered = !string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || !string.IsNullOrEmpty(ViewBag.CurrentSubject as string)
        || ViewBag.CurrentGrade != null || !string.IsNullOrEmpty(ViewBag.CurrentDifficulty as string)
        || curVersion.HasValue || curComponent.HasValue || curTopic.HasValue;
}
<link rel="stylesheet" href="~/css/syllabus.css" asp-append-version="true" />

<div class="row mb-4 align-items-center">
  <div class="col">
    @if (pickerMode)
    {
      <a href="/Assignments/Edit/@assignmentId" class="btn btn-sm btn-outline-secondary me-2">
        <i class="bx bx-arrow-back me-1"></i>Back to assignment
      </a>
      <h4 class="fw-bold py-3 mb-0 d-inline-block">
        <span class="text-muted fw-light">Add from</span> Content Library
      </h4>
    }
    else
    {
      <h4 class="fw-bold py-3 mb-0">
        <span class="text-muted fw-light">SmartSchool AI /</span> Content Library
      </h4>
    }
  </div>
  <div class="col-auto">
    <a href="/ContentLibrary/Create@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-primary">
      <i class="bx bx-plus me-1"></i> @(pickerMode ? "Create new question" : "Add Question")
    </a>
  </div>
</div>

<!-- Filters -->
<div class="card mb-4">
  <div class="card-body">
    <form method="get" class="row g-3 align-items-end" id="libraryFilters">
      @if (pickerMode)
      {
        <input type="hidden" name="assignmentId" value="@assignmentId" />
      }
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bx bx-search"></i></span>
          <input type="text" class="form-control" name="search"
                 value="@ViewBag.CurrentSearch" placeholder="Search questions..." />
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Subject</label>
        <select class="form-select" name="subject">
          <option value="">All subjects</option>
          @foreach (var s in subjects)
          {
            if (ViewBag.CurrentSubject == s)
            {
              <option value="@s" selected>@s</option>
            }
            else
            {
              <option value="@s">@s</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Grade</label>
        <select class="form-select" name="grade">
          <option value="">All grades</option>
          @for (int g = 1; g <= 12; g++)
          {
            if (ViewBag.CurrentGrade?.ToString() == g.ToString())
            {
              <option value="@g" selected>Grade @g</option>
            }
            else
            {
              <option value="@g">Grade @g</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Difficulty</label>
        <select class="form-select" name="difficulty">
          <option value="">All levels</option>
          @foreach (var (val, label) in new[] { ("Easy","🌶 Easy"), ("Medium","🌶🌶 Medium"), ("Hard","🌶🌶🌶 Hard") })
          {
            if (ViewBag.CurrentDifficulty == val)
            {
              <option value="@val" selected>@label</option>
            }
            else
            {
              <option value="@val">@label</option>
            }
          }
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <i class="bx bx-filter-alt me-1"></i> Filter
        </button>
        <a href="/ContentLibrary@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-outline-secondary" title="Clear filters" aria-label="Clear filters" id="clearFilters">
          <i class="bx bx-x"></i>
        </a>
      </div>
      @if (syllabusCatalog.Count > 0)
      {
        <!-- Optional: questions the teacher aligned to a published syllabus. Combine with the filters above. -->
        <div class="col-12 col-md-4">
          <label class="form-label small fw-semibold" for="filterSyllabusVersion">Cambridge syllabus</label>
          <select class="form-select" name="syllabusVersion" id="filterSyllabusVersion" data-sp-reset="filterSyllabusComponent,filterSyllabusTopic">
            <option value="">Any (or none)</option>
            @foreach (var v in syllabusCatalog)
            {
              <option value="@v.Id" selected="@(curVersion == v.Id)">@v.Label</option>
            }
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label small fw-semibold" for="filterSyllabusComponent">Component</label>
          <select class="form-select" name="syllabusComponent" id="filterSyllabusComponent" data-sp-reset="filterSyllabusTopic" disabled="@(spVersion is null)">
            <option value="">@(spVersion is null ? "Choose a syllabus first" : "All components")</option>
            @foreach (var c in spVersion?.Components ?? new())
            {
              <option value="@c.Id" selected="@(spComponent?.Id == c.Id && curComponent.HasValue)">@c.Number · @c.Title</option>
            }
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label small fw-semibold" for="filterSyllabusTopic">Topic</label>
          <select class="form-select" name="syllabusTopic" id="filterSyllabusTopic" disabled="@(spVersion is null)">
            <option value="">All topics</option>
            @foreach (var (t, c) in spTopics)
            {
              <option value="@t.Id" selected="@(curTopic == t.Id)">@t.Title@(spComponent is null ? $" · {c.Title}" : "")</option>
            }
          </select>
        </div>
      }
    </form>
  </div>
</div>

@if (pickerMode)
{
  <div class="alert alert-primary d-flex align-items-center gap-2 mb-4 py-2">
    <i class="bx bx-info-circle fs-5"></i>
    <span>Select questions to add to your assignment, or <a href="/ContentLibrary/Create?assignmentId=@assignmentId" class="fw-semibold">create a new one</a>.</span>
  </div>
}

@if (!Model.Any() && filtered)
{
  <div class="card" id="libraryNoMatch">
    <div class="card-body text-center py-5">
      <i class="bx bx-search-alt" style="font-size:3rem; color:#696cff;" aria-hidden="true"></i>
      <h5 class="mt-3">No questions match these filters</h5>
      <p class="text-muted">Change a filter, or clear them to see every question.</p>
      <a href="/ContentLibrary@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-outline-primary">Clear filters</a>
    </div>
  </div>
}
else if (!Model.Any())
{
  <div class="card">
    <div class="card-body text-center py-5">
      <i class="bx bx-book-open" style="font-size:3rem; color:#696cff;"></i>
      <h5 class="mt-3">No questions yet</h5>
      <p class="text-muted">Build your library by adding reusable questions.</p>
      <a href="/ContentLibrary/Create@(pickerMode ? $"?assignmentId={assignmentId}" : "")" class="btn btn-primary">
        <i class="bx bx-plus me-1"></i> Add First Question
      </a>
    </div>
  </div>
}
else
{
  <div class="card">
    <div class="card-header d-flex align-items-center justify-content-between py-3">
      <span class="text-muted small">
        <strong>@pageInfo.Total</strong> question@(pageInfo.Total != 1 ? "s" : "") found
      </span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:42%">Question</th>
            <th>Type</th>
            <th>Subject / Grade</th>
            <th>Difficulty</th>
            <th>Answer</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var q in Model)
          {
            var (typeIcon, typeLabel) = q.Type switch
            {
              SmartSchoolAI.Models.QuestionType.ShortAnswer    => ("bx-text",    "Short Answer"),
              SmartSchoolAI.Models.QuestionType.MultipleChoice => ("bx-list-ul", "Multiple Choice"),
              SmartSchoolAI.Models.QuestionType.OpenText       => ("bx-edit",    "Open Text"),
              SmartSchoolAI.Models.QuestionType.MathExpression => ("bx-math",    "Math"),
              _ => ("bx-question-mark", q.Type.ToString())
            };
            var (diffColor, diffLabel, diffEmoji) = q.Difficulty switch
            {
              SmartSchoolAI.Models.DifficultyLevel.Easy   => ("success", "Easy",   "🌶"),
              SmartSchoolAI.Models.DifficultyLevel.Medium => ("warning", "Medium", "🌶🌶"),
              SmartSchoolAI.Models.DifficultyLevel.Hard   => ("danger",  "Hard",   "🌶🌶🌶"),
              _ => ("secondary", q.Difficulty.ToString(), "")
            };
            <tr>
              <td>
                <div class="fw-semibold">@q.Title</div>
                @if (!string.IsNullOrEmpty(q.Explanation))
                {
                  <small class="text-muted">
                    @(q.Explanation.Length > 70 ? q.Explanation[..70] + "…" : q.Explanation)
                  </small>
                }
              </td>
              <td>
                <span class="badge bg-label-secondary">
                  <i class="bx @typeIcon me-1"></i>@typeLabel
                </span>
              </td>
              <td>
                @if (q.Subject != null)
                {
                  <span class="d-block fw-semibold small">@q.Subject</span>
                }
                @if (q.GradeLevel.HasValue)
                {
                  <small class="text-muted">Grade @q.GradeLevel</small>
                }
                @if (q.SyllabusTopicId is { } stid && syllabusLabels.TryGetValue(stid, out var sl))
                {
                  <span class="badge bg-label-info syllabus-chip d-inline-block mt-1" title="Aligned to Cambridge @sl.Code: @sl.Full" data-syllabus-label>@sl.Short</span>
                }
              </td>
              <td>
                <span class="badge bg-label-@diffColor">@diffEmoji @diffLabel</span>
              </td>
              <td>
                <code class="text-success fw-semibold small">@q.AnswerKey</code>
              </td>
              <td>
                <div class="d-flex gap-1 align-items-center">
                  @if (pickerMode)
                  {
                    <form method="post" action="/ContentLibrary/AttachToAssignment">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="questionId"   value="@q.Id" />
                      <input type="hidden" name="assignmentId" value="@assignmentId" />
                      <button type="submit" class="btn btn-sm btn-primary" title="Add to assignment">
                        <i class="bx bx-plus me-1"></i>Add
                      </button>
                    </form>
                  }
                  <a href="/ContentLibrary/Edit/@q.Id"
                     class="btn btn-sm btn-icon btn-outline-primary" title="Edit">
                    <i class="bx bx-edit"></i>
                  </a>
                  <form method="post" action="/ContentLibrary/Delete/@q.Id"
                        onsubmit="return confirm('Delete this question?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@hereUrl" />
                    <button type="submit" class="btn btn-sm btn-icon btn-outline-danger" title="Delete">
                      <i class="bx bx-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
    <partial name="_Pager" model="pageInfo" />
  </div>
}

<script>
  // Syllabus filters narrow step by step: changing the syllabus or component clears the narrower choices, then applies.
  document.querySelectorAll('#libraryFilters select[name^="syllabus"]').forEach(sel => sel.addEventListener('change', () => {
    (sel.dataset.spReset || '').split(',').filter(Boolean).forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    sel.form.requestSubmit();
  }));
</script>
