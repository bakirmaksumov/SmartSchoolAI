@{
    ViewData["Title"] = "Create Class";
}

<div class="row mb-4">
  <div class="col">
    <h4 class="fw-bold py-3 mb-0">
      <span class="text-muted fw-light">SmartSchool AI / <a href="/Classes">My Classes</a> /</span> Create
    </h4>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i class="bx bx-group me-2"></i>New Class</h5>
      </div>
      <div class="card-body">

        @if (!string.IsNullOrEmpty(ViewBag.Error?.ToString()))
        {
          <div class="alert alert-danger">
            <i class="bx bx-error-circle me-1"></i> @ViewBag.Error
          </div>
        }

        <form method="post" asp-action="Create" asp-controller="Classes">
          @Html.AntiForgeryToken()

          <div class="mb-3">
            <label class="form-label">Class Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name"
                   placeholder="e.g. 8A — Algebra" required autofocus />
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Subject <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="subject"
                     placeholder="e.g. Mathematics" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Grade Level</label>
              <select class="form-select" name="gradeLevel">
                @for (int i = 1; i <= 12; i++)
                {
                  <option value="@i">Grade @i</option>
                }
              </select>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label">Academic Year</label>
            <select class="form-select" name="academicYear">
              <option value="2025-2026">2025–2026</option>
              <option value="2026-2027">2026–2027</option>
            </select>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bx bx-save me-1"></i> Create Class
            </button>
            <a href="/Classes" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>
