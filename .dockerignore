*.db-shm
*.db-wal
*.db.backup-*
*.log
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Production.json
*.csproj.user

# Docker files themselves
Dockerfile
docker-compose*.yml
.dockerignore
